// Design tokens of the reference design, named after the Figma variables in kebab-case.

export global Theme {
    out property <color> bg-base: #0b0d12;
    out property <color> bg-hover: #1f2430;
    out property <color> bg-elevated: #181c25;
    out property <color> border-default: #2b3242;
    out property <color> text-primary: #e8ebf1;
    out property <color> text-secondary: #a9b0bf;
    out property <color> text-muted: #6b7385;
    out property <color> text-on-accent: #0b0d12;
    out property <color> accent: #4cc9f0;
    out property <color> watched: #4ade80;
    out property <color> progress-track: #6b7385;
    out property <color> danger: #f87171;
    out property <color> warning: #fbbf24;

    // Gradients drawn in the design without a variable.
    out property <brush> top-bar-scrim: @linear-gradient(180deg, #0b0d12f2 0%, #0b0d1200 100%);
    out property <brush> hero-scrim-bottom: @linear-gradient(180deg, #0b0d1200 55%, #0b0d12 100%);
    out property <brush> hero-scrim-left: @linear-gradient(90deg, #0b0d12f2 0%, #0b0d1200 60%);
    out property <brush> detail-scrim: #0b0d12b8;
    out property <brush> hero-placeholder: @linear-gradient(154deg, #1f4761 7%, #141f33 46%, #331a38 79%);
    out property <brush> poster-placeholder: @linear-gradient(132deg, #384573 14%, #141a29 86%);
    out property <brush> landscape-placeholder: @linear-gradient(157deg, #59384d 14%, #1a1424 86%);
    out property <brush> sign-in-glow: @radial-gradient(circle, #12404f99 0%, #0b0d1200 70%);
    out property <color> card-shadow: #00000066;
    // Behind the video until its first frame.
    out property <color> video-backdrop: #000000;
    // Player overlays, readable over any video.
    out property <brush> player-scrim-top: @linear-gradient(180deg, #000000bf 0%, #00000000 100%);
    out property <brush> player-scrim-bottom: @linear-gradient(180deg, #00000000 0%, #000000d9 100%);
    out property <brush> next-up-placeholder: @linear-gradient(157deg, #335966 14%, #0f1a1f 86%);
    out property <color> menu-shadow: #00000080;
    // Subtitle preview, matching what mpv draws.
    out property <color> subtitle-white: #ffffff;
    out property <color> subtitle-yellow: #ffe000;
    out property <color> subtitle-outline: #000000;
    out property <color> subtitle-box: #000000af;

    out property <length> space-2xs: 2px;
    out property <length> space-xs: 4px;
    out property <length> space-chip-y: 6px;
    out property <length> space-pill-y: 10px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-2xl: 32px;
    out property <length> space-3xl: 48px;

    out property <length> poster-width: 160px;
    out property <length> poster-height: 240px;
    out property <length> episode-thumb-width: 224px;
    out property <length> episode-thumb-height: 126px;
    out property <length> episode-text-gap: 6px;
    // Between the icons and the label of a text link.
    out property <length> link-gap: 6px;
    out property <length> link-icon-size: 16px;
    // Widest line of the summary of a detail page.
    out property <length> detail-text-width: 640px;
    // Widest a button naming a title grows before its label is cut.
    out property <length> titled-button-width: 360px;
    out property <length> seek-preview-width: 240px;
    // Player menus: their usual width, and the widest the track menu grows to fit its rows.
    out property <length> menu-width: 280px;
    out property <length> menu-max-width: 420px;
    // Chapters menu and its thumbnails.
    out property <length> chapter-menu-width: 360px;
    // Playback statistics panel, its label column and the top and bottom padding of a row.
    out property <length> stats-panel-width: 380px;
    out property <length> stats-label-width: 120px;
    out property <length> stats-row-padding-y: 3px;
    out property <length> chapter-thumb-width: 64px;
    out property <length> chapter-thumb-height: 36px;
    // Cut in the seek bar at each chapter start.
    out property <length> chapter-gap-width: 3px;
    out property <length> chapter-gap-height: 8px;
    // Tick on the seek bar at the hovered time.
    out property <length> seek-marker-width: 2px;
    out property <length> seek-marker-height: 12px;
    // Side padding of the seek preview label.
    out property <length> seek-label-padding-x: 10px;
    // Countdown line along the bottom edge of the next episode toast.
    out property <length> countdown-height: 3px;

    out property <length> radius-indicator: 2px;
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> radius-full: 999px;

    out property <length> border-thin: 1px;
    out property <length> border-focus: 2px;

    out property <float> disabled-opacity: 0.4;

    out property <length> display-size: 40px;
    out property <int> display-weight: 700;
    out property <length> display-line-height: 48px;
    out property <length> heading-size: 20px;
    out property <int> heading-weight: 600;
    out property <length> heading-line-height: 26px;
    out property <length> brand-size: 28px;
    out property <length> body-size: 15px;
    out property <int> body-weight: 400;
    out property <length> body-line-height: 22px;
    out property <length> body-strong-size: 15px;
    out property <int> body-strong-weight: 600;
    out property <length> body-strong-line-height: 22px;
    out property <length> label-size: 13px;
    out property <int> label-weight: 500;
    out property <length> label-line-height: 18px;
    out property <length> caption-size: 12px;
    out property <int> caption-weight: 400;
    out property <length> caption-line-height: 16px;

    // Inter's natural line height per em: (ascender 1984 + descender 494) / 2048.
    out property <float> inter-line-height: 1.21;

    // Slint only knows a line height relative to the font's natural one.
    public pure function line-height-factor(size: length, line-height: length) -> float {
        line-height / (size * inter-line-height)
    }
}

export struct CardData {
    id: string,
    title: string,
    subtitle: string,
    progress: float,
    watched: bool,
    image: image,
    has-image: bool,
}

export struct TrackRow {
    index: int,
    label: string,
    detail: string,
    forced: bool,
    external: bool,
    selected: bool,
}

// A chapter of the player menu. `title` is empty when the media names none; `start` is in seconds.
export struct ChapterRow {
    title: string,
    start-label: string,
    start: float,
    image: image,
    has-image: bool,
}

// A streaming quality of the player menu: `height` and `kbps` are 0 for the original quality.
export struct QualityRow {
    height: int,
    kbps: int,
}

// A row of the playback statistics panel: `warn` shows the value in the warning color, `good`
// in the watched color.
export struct StatRow {
    label: string,
    value: string,
    warn: bool,
    good: bool,
}

// A section of the playback statistics panel; `title` is shown in capitals.
export struct StatSection {
    title: string,
    rows: [StatRow],
}

// Part of the playing item the player offers to skip, mirroring the core `SegmentKind`.
export enum SkipKind { none, intro, recap, preview, credits }

// A segment skipped without asking: `kind` is none when nothing was; each skip has a new `serial`.
export struct Skipped {
    kind: SkipKind,
    serial: int,
}

// Seek bar thumbnails of the playing item, mirroring the core `Trickplay`; `count` is 0 without any.
export struct TrickplayGrid {
    item: string,
    source: string,
    resolution: int,
    width: int,
    height: int,
    columns: int,
    rows: int,
    count: int,
    interval-ms: int,
}

// What the seek bar preview shows: the hovered time and, once its sheet is loaded, the
// thumbnail of that time as a rectangle of `image` in pixels. `sheet` names the sheet wanted.
// `chapter-number` counts from 1 and is 0 when the time has no chapter; `chapter` is its name.
export struct SeekPreview {
    time: string,
    chapter: string,
    chapter-number: int,
    sheet: string,
    has-image: bool,
    image: image,
    x: int,
    y: int,
    width: int,
    height: int,
}

// The next episode offered at the end of an episode. `ask` waits for the user; otherwise it starts
// once `remaining` of `total` seconds have passed.
export struct NextUp {
    visible: bool,
    id: string,
    title: string,
    remaining: int,
    total: int,
    ask: bool,
    image: image,
    has-image: bool,
}

// Every message the interface can show, mapped from core errors and events.
export enum Message {
    server-unreachable,
    invalid-server-url,
    unsupported-server,
    invalid-credentials,
    quick-connect-disabled,
    quick-connect-expired,
    server-error,
    unexpected-response,
    storage-error,
    session-expired,
    file-token-warning,
    no-playable-source,
    nothing-to-play,
    load-failed,
    command-failed,
    playback-unavailable,
}

export global Messages {
    // The kind named on the cards of the series of a person page.
    public pure function series-kind() -> string {
        @tr("Series")
    }

    public pure function server-found(name: string, version: string) -> string {
        if name.is-empty {
            return @tr("Server found (Jellyfin {})", version);
        }
        @tr("Server found: {} (Jellyfin {})", name, version)
    }

    // The name of chapter `number`, counted from 1, or a numbered one when the media names none.
    public pure function chapter-title(title: string, number: int) -> string {
        if title.is-empty {
            return @tr("Chapter {}", number);
        }
        title
    }

    // An audio or subtitle delay given in milliseconds, in seconds to the tenth, such as "+0.3 s".
    public pure function delay-text(ms: int) -> string {
        @tr("{}{}.{} s", ms < 0 ? "-" : "+", floor(abs(ms) / 1000), mod(floor(abs(ms) / 100), 10))
    }

    // `detail` is only used by `unsupported-server` and carries "<installed> / <required>" versions.
    public pure function message-text(m: Message, detail: string) -> string {
        if m == Message.server-unreachable {
            return @tr("Cannot reach the server. Check the address and your connection.");
        }
        if m == Message.invalid-server-url {
            return @tr("This server address is not valid.");
        }
        if m == Message.unsupported-server {
            return @tr("This Jellyfin version is not supported (installed / required: {}).", detail);
        }
        if m == Message.invalid-credentials {
            return @tr("Incorrect username or password.");
        }
        if m == Message.quick-connect-disabled {
            return @tr("Quick Connect is disabled on this server.");
        }
        if m == Message.quick-connect-expired {
            return @tr("The Quick Connect code has expired.");
        }
        if m == Message.server-error {
            return @tr("The server ran into an error. Please try again later.");
        }
        if m == Message.unexpected-response {
            return @tr("The server sent a response Oxyfin does not understand.");
        }
        if m == Message.storage-error {
            return @tr("Oxyfin could not read or save its settings.");
        }
        if m == Message.session-expired {
            return @tr("Your session has expired. Please sign in again.");
        }
        if m == Message.file-token-warning {
            return @tr("The system keyring is unavailable, so your sign-in token is stored in a file only you can read.");
        }
        if m == Message.no-playable-source {
            return @tr("The server offers no version of this item that Oxyfin can play.");
        }
        if m == Message.nothing-to-play {
            return @tr("There is nothing left to play in this series.");
        }
        if m == Message.load-failed {
            return @tr("This item could not be loaded.");
        }
        if m == Message.command-failed {
            return @tr("The player could not complete that action.");
        }
        if m == Message.playback-unavailable {
            return @tr("Playback is not available in this build of Oxyfin.");
        }
        ""
    }
}
