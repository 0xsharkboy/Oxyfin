import { MovieScreen, MovieData } from "screens/movie.slint";
import { SeriesScreen, SeriesData, SeriesPlayKind, EpisodeData } from "screens/series.slint";
import { PersonScreen, PersonData, PersonFilter } from "screens/person.slint";
import { PersonCardData, PersonJob } from "components/person_card.slint";
import { CollectionScreen, CollectionData } from "screens/collection.slint";
import { TopBarPage } from "components/top_bar.slint";
import { NoticeBanner, NoticeData } from "components/notice_banner.slint";
import { HoverCard, HoverCardOverlay, HoverDetails, HoverKind } from "components/hover_card.slint";
import { Pointed } from "components/pointed.slint";
import { ContextMenu, ContextMenuOverlay, MenuAction, MenuEntry } from "components/context_menu.slint";
import { MouseBack } from "components/mouse_back.slint";
import { Shortcut, ShortcutKey, Shortcuts, ShortcutsOverlay } from "components/shortcuts_overlay.slint";

export { CardData, ChapterRow, Message, Messages, NextUp, QualityRow, SeekPreview, SkipKind, Skipped, StatRow, StatSection, TrackRow, TrickplayGrid } from "theme.slint";
export { StatsTitles }
export { SubtitleResult, SubtitleRowState, SubtitleSearch } from "components/subtitle_search.slint";
export { FoundServer, ServerState, ServerStatus }
export { HomeBanner, HomeRow, HomeRowKind, HomeTitles }
export { BannerKind } from "components/banner.slint";
export { NoticeData }
export { HoverCard, HoverDetails, HoverKind }
export { ContextMenu, MenuAction, MenuEntry }
export { MouseBack }
export { Shortcut, ShortcutKey, Shortcuts }
export { LibraryTitles }
export { SearchTitles }
export { MovieData }
export { SeriesData, SeriesPlayKind, EpisodeData }
export { PersonData, PersonFilter, PersonCardData, PersonJob }
export { CollectionData }
export { TopBarPage }
export { AuthorizeState, PlaybackChoice, SubtitleChoice, TokenStore }

// Mirrors the Rust `state::Screen` one to one.
export enum Screen { starting, sign-in, quick-connect, home, library, search, movie, series, person, collection, player, settings }

export component AppWindow inherits Window {
    in property <Screen> screen: Screen.starting;

    in-out property <string> server-address;
    in-out property <string> username;
    in property <ServerStatus> server-status;
    in property <bool> busy;
    in property <string> form-error;
    in property <[FoundServer]> found-servers;
    callback server-changed(address: string);
    callback server-confirmed(address: string);
    callback sign-in(username: string, password: string);
    callback open-quick-connect();
    callback found-server-chosen(address: string);

    in property <string> quick-connect-code;
    in property <[string]> quick-connect-digits;
    in property <string> quick-connect-error;
    in property <bool> quick-connect-can-retry;
    callback cancel-quick-connect();
    callback retry-quick-connect();

    in property <HomeBanner> home-banner;
    in property <[HomeRow]> home-rows;
    in property <bool> home-settled;
    // True during the first load of the home screen.
    in property <bool> home-loading;
    callback play(id: string);
    callback open-item(id: string);
    callback open-settings();
    // Leaves a detail page for the screen below it.
    callback back();

    // Tab of the top bar that stays underlined: the root of the screen stack.
    in property <TopBarPage> top-bar-page: TopBarPage.none;
    callback open-tab(page: TopBarPage);

    in property <[CardData]> library-cards;
    in property <int> library-total;
    in property <bool> library-loading;
    in property <bool> library-loading-more;
    in property <string> library-error;
    in property <bool> library-more-failed;
    in property <bool> library-filtered;
    in property <int> library-watch;
    in property <[string]> library-genres;
    in property <int> library-genre;
    in property <int> library-sort-field;
    in property <bool> library-descending;
    in-out property <length> library-viewport-y;
    callback library-watch-selected(index: int);
    callback library-genre-selected(index: int);
    callback library-sort-selected(index: int);
    callback library-direction-toggled();
    callback library-near-end();
    callback library-open(id: string);
    callback library-retry();
    callback library-retry-more();

    in-out property <string> search-text;
    in property <[CardData]> search-cards;
    in property <int> search-total;
    in property <string> search-query;
    in property <bool> search-loading;
    in property <bool> search-loading-more;
    in property <string> search-error;
    in property <bool> search-more-failed;
    in-out property <length> search-viewport-y;
    callback search-edited(text: string);
    callback search-accepted(text: string);
    callback search-near-end();
    callback search-open(id: string);
    callback search-retry();
    callback search-retry-more();

    in property <bool> movie-loaded;
    in-out property <length> movie-viewport-y;
    in property <bool> movie-loading;
    in property <string> movie-error;
    in property <MovieData> movie-data;
    in property <image> movie-poster;
    in property <image> movie-backdrop;
    in property <bool> movie-busy;
    in property <[PersonCardData]> movie-people;
    in property <[CardData]> movie-similar;
    in property <[string]> movie-collections;
    callback movie-play(from-start: bool);
    callback movie-toggle-watched();
    callback movie-toggle-favorite();
    callback movie-retry();
    callback movie-open-similar(id: string);
    callback movie-open-person(id: string);
    callback movie-open-collection(index: int);

    in property <bool> series-loaded;
    in-out property <length> series-viewport-y;
    in property <bool> series-loading;
    in property <string> series-error;
    in property <SeriesData> series-data;
    in property <image> series-poster;
    in property <image> series-backdrop;
    in property <bool> series-busy;
    in property <[string]> series-seasons;
    in property <[string]> series-season-ids;
    in property <int> series-season: -1;
    in property <[EpisodeData]> series-episodes;
    in property <bool> series-episodes-loading;
    in property <bool> series-episodes-stale;
    in property <string> series-episodes-error;
    in property <[PersonCardData]> series-people;
    in property <[CardData]> series-similar;
    callback series-play();
    callback series-play-episode(id: string);
    callback series-select-season(index: int);
    callback series-toggle-watched();
    callback series-toggle-favorite();
    callback series-retry();
    callback series-retry-episodes();
    callback series-open-similar(id: string);
    callback series-open-person(id: string);

    in property <bool> person-loaded;
    in property <bool> person-loading;
    in property <string> person-error;
    in property <PersonData> person-data;
    in property <image> person-photo;
    in property <bool> person-has-photo;
    in property <[CardData]> person-titles;
    in property <PersonFilter> person-filter;
    in-out property <bool> person-expanded;
    in-out property <length> person-viewport-y;
    callback person-select-filter(filter: PersonFilter);
    callback person-open(id: string);
    callback person-retry();

    in property <bool> collection-loaded;
    in-out property <length> collection-viewport-y;
    in property <bool> collection-loading;
    in property <string> collection-error;
    in property <CollectionData> collection-data;
    in property <image> collection-poster;
    in property <image> collection-backdrop;
    in property <bool> collection-busy;
    in property <[CardData]> collection-items;
    callback collection-play();
    callback collection-toggle-watched();
    callback collection-toggle-favorite();
    callback collection-open(id: string);
    callback collection-retry();

    in property <string> player-title;
    in property <string> player-subtitle;
    in property <bool> player-loading;
    in property <bool> player-has-error;
    in property <Message> player-error;
    in property <bool> player-video-active;
    in property <float> player-position;
    in property <float> player-duration;
    in property <string> player-elapsed;
    in property <string> player-total;
    // The time left, shown instead of the total when `player-time-remaining` is set.
    in property <string> player-remaining;
    in-out property <bool> player-time-remaining;
    callback player-time-remaining-changed(remaining: bool);
    in property <bool> player-paused;
    in property <float> player-volume: 100;
    in property <bool> player-muted;
    in property <float> player-speed: 1;
    in property <[float]> player-speeds;
    in property <[QualityRow]> player-qualities;
    in property <int> player-quality;
    in property <bool> player-has-next;
    in property <[TrackRow]> player-audio;
    in property <[TrackRow]> player-subtitles;
    in property <int> player-audio-delay;
    in property <int> player-subtitle-delay;
    in property <[ChapterRow]> player-chapters;
    in property <int> player-current-chapter: -1;
    in property <[float]> player-chapter-marks;
    in property <NextUp> player-next-up;
    in property <SkipKind> player-skip-kind;
    // Where skipping the offered segment seeks to, in seconds.
    in property <float> player-skip-end;
    in property <Skipped> player-skipped;
    // Set while a seek is on its way; the position is frozen until the player confirms it.
    in property <bool> player-seek-pending;
    // Last position the player reported, kept while a seek is pending, in seconds.
    in-out property <float> player-reported-position;
    in-out property <bool> player-scrubbing;
    in property <TrickplayGrid> player-trickplay;
    in property <SeekPreview> player-preview;
    callback player-preview-requested(seconds: float);
    // Whether the player turned fullscreen on: leaving the player or Escape drops only that one.
    in-out property <bool> player-fullscreen-own;
    // Toggles fullscreen, from F11 on any screen and from the player controls.
    callback toggle-fullscreen();
    callback player-cursor-hidden(x: length, y: length);
    callback player-command-stop();
    callback player-command-retry();
    callback player-command-set-paused(paused: bool);
    callback player-command-seek(seconds: float);
    callback player-command-skip(direction: int);
    callback player-command-previous();
    callback player-command-next();
    callback player-command-play-next-now();
    callback player-command-cancel-next-up();
    callback player-command-undo-skip();
    callback player-command-skip-segment();
    callback player-command-set-speed(speed: float);
    callback player-command-step-speed(direction: int);
    callback player-command-set-quality(index: int);
    callback player-command-set-volume(volume: float);
    callback player-command-step-volume(direction: int);
    callback player-command-set-muted(muted: bool);
    callback player-command-select-audio(index: int);
    callback player-command-select-subtitle(index: int);
    callback player-command-step-audio-delay(direction: int);
    callback player-command-set-audio-delay(ms: int);
    callback player-command-step-subtitle-delay(direction: int);
    callback player-command-set-subtitle-delay(ms: int);
    callback player-command-step-chapter(direction: int);
    in property <[StatSection]> player-stats;
    // Whether the playback statistics show.
    in-out property <bool> player-stats-visible;
    callback player-command-stats();
    callback close-player();

    in property <string> settings-server-name;
    in property <string> settings-server-address;
    in property <string> settings-user-name;
    in property <TokenStore> settings-token-store;
    in property <SubtitleChoice> settings-subtitles;
    callback settings-subtitles-changed(choice: SubtitleChoice);
    in property <bool> settings-start-fullscreen;
    callback settings-start-fullscreen-changed(on: bool);
    in property <bool> settings-discord;
    callback settings-discord-changed(on: bool);
    in property <PlaybackChoice> settings-playback;
    callback settings-playback-changed(choice: PlaybackChoice);
    in-out property <string> settings-authorize-code;
    in-out property <AuthorizeState> settings-authorize-state;
    pure callback settings-code-ready(code: string) -> bool;
    callback settings-authorize(code: string);
    in property <int> settings-image-cache-kb: -1;
    callback settings-clear-image-cache();
    in property <bool> settings-logs-copied;
    // The last "Copy logs" could not reach the clipboard.
    in property <bool> settings-logs-copy-failed;
    callback settings-copy-logs();
    callback settings-open-logs();
    in property <string> app-version;
    callback close-settings();
    callback sign-out();

    in property <NoticeData> notice;
    callback dismiss-notice();
    callback undo-notice();

    // True while the pointer rests on something that must not move, or a menu is open over it.
    out property <bool> content-held: Pointed.holder != 0 || ContextMenu.open;
    callback content-released();
    changed content-held => {
        if !root.content-held {
            root.content-released();
        }
    }

    title: "Oxyfin";
    background: transparent;
    default-font-family: "Inter";
    preferred-width: 1280px;
    preferred-height: 720px;

    forward-focus: keys;
    // The screens that take no focus of their own leave it here, where F11 works.
    changed screen => {
        HoverCard.hide();
        Pointed.reset();
        ContextMenu.close();
        ContextMenu.focus-id = "";
        Shortcuts.close();
        if root.screen == Screen.starting || root.screen == Screen.sign-in || root.screen == Screen.quick-connect || root.screen == Screen.home || root.screen == Screen.library {
            keys.focus();
        }
    }

    // Wraps every screen, so F11 reaches it whatever has the focus.
    keys := FocusScope {
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.F11 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                root.toggle-fullscreen();
                return accept;
            }
            // The shortcuts dialog keeps the keys, and the focus stays where it was below it.
            if Shortcuts.open {
                if event.text == Key.Escape || event.text == "?" {
                    Shortcuts.close();
                }
                return accept;
            }
            // The menu never takes the focus, so the focused element keeps it once the menu closes.
            if ContextMenu.open {
                ContextMenu.key(event);
                return accept;
            }
            reject
        }
        // Not captured: a text field keeps the `?` typed in it.
        key-pressed(event) => {
            if event.text == "?" && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                Shortcuts.show();
                return accept;
            }
            reject
        }

        // Once the element given the focus back after a menu row is gone, such as a card taken
        // out of its row, the focus comes back here and to the screen: keys keep working.
        Timer {
            interval: Theme.focus-check-interval;
            running: ContextMenu.focus-id != "";
            triggered => {
                if ContextMenu.focus-answer != ContextMenu.focus-check {
                    keys.focus();
                    ContextMenu.focus-gone();
                } else {
                    ContextMenu.focus-held();
                }
            }
        }

        // The video is drawn under the interface, so the player screen leaves the window transparent.
        if root.screen != Screen.player: Rectangle {
            background: Theme.bg-base;
        }

        if root.screen == Screen.starting: StartingScreen { }

        if root.screen == Screen.sign-in: SignInScreen {
            server-address <=> root.server-address;
            username <=> root.username;
            server-status: root.server-status;
            busy: root.busy;
            form-error: root.form-error;
            found-servers: root.found-servers;
            server-changed(address) => {
                root.server-changed(address);
            }
            server-confirmed(address) => {
                root.server-confirmed(address);
            }
            sign-in(username, password) => {
                root.sign-in(username, password);
            }
            open-quick-connect => {
                root.open-quick-connect();
            }
            found-server-chosen(address) => {
                root.found-server-chosen(address);
            }
        }

        if root.screen == Screen.quick-connect: QuickConnectScreen {
            code: root.quick-connect-code;
            digits: root.quick-connect-digits;
            error: root.quick-connect-error;
            can-retry: root.quick-connect-can-retry;
            cancel => {
                root.cancel-quick-connect();
            }
            retry => {
                root.retry-quick-connect();
            }
        }

        if root.screen == Screen.home: HomeScreen {
            banner: root.home-banner;
            rows: root.home-rows;
            settled: root.home-settled;
            loading: root.home-loading;
            open-tab(page) => {
                root.open-tab(page);
            }
            play(id) => {
                root.play(id);
            }
            open-item(id) => {
                root.open-item(id);
            }
            open-settings => {
                root.open-settings();
            }
        }

        if root.screen == Screen.library: LibraryScreen {
            page: root.top-bar-page;
            cards: root.library-cards;
            total: root.library-total;
            loading: root.library-loading;
            loading-more: root.library-loading-more;
            error: root.library-error;
            more-failed: root.library-more-failed;
            filtered: root.library-filtered;
            watch: root.library-watch;
            genres: root.library-genres;
            genre: root.library-genre;
            sort-field: root.library-sort-field;
            descending: root.library-descending;
            viewport-y <=> root.library-viewport-y;
            watch-selected(index) => {
                root.library-watch-selected(index);
            }
            genre-selected(index) => {
                root.library-genre-selected(index);
            }
            sort-selected(index) => {
                root.library-sort-selected(index);
            }
            direction-toggled => {
                root.library-direction-toggled();
            }
            near-end => {
                root.library-near-end();
            }
            open(id) => {
                root.library-open(id);
            }
            retry => {
                root.library-retry();
            }
            retry-more => {
                root.library-retry-more();
            }
            open-tab(page) => {
                root.open-tab(page);
            }
            open-settings => {
                root.open-settings();
            }
        }

        if root.screen == Screen.search: SearchScreen {
            page: root.top-bar-page;
            text <=> root.search-text;
            cards: root.search-cards;
            total: root.search-total;
            query: root.search-query;
            loading: root.search-loading;
            loading-more: root.search-loading-more;
            error: root.search-error;
            more-failed: root.search-more-failed;
            viewport-y <=> root.search-viewport-y;
            edited(text) => {
                root.search-edited(text);
            }
            accepted(text) => {
                root.search-accepted(text);
            }
            near-end => {
                root.search-near-end();
            }
            open(id) => {
                root.search-open(id);
            }
            retry => {
                root.search-retry();
            }
            retry-more => {
                root.search-retry-more();
            }
            open-tab(page) => {
                root.open-tab(page);
            }
            open-settings => {
                root.open-settings();
            }
        }

        if root.screen == Screen.movie: MovieScreen {
            active: root.screen == Screen.movie;
            viewport-y <=> root.movie-viewport-y;
            page: root.top-bar-page;
            loaded: root.movie-loaded;
            loading: root.movie-loading;
            error: root.movie-error;
            movie: root.movie-data;
            poster: root.movie-poster;
            backdrop: root.movie-backdrop;
            busy: root.movie-busy;
            people: root.movie-people;
            similar: root.movie-similar;
            collections: root.movie-collections;
            play(from-start) => {
                root.movie-play(from-start);
            }
            toggle-watched => {
                root.movie-toggle-watched();
            }
            toggle-favorite => {
                root.movie-toggle-favorite();
            }
            retry => {
                root.movie-retry();
            }
            open-item(id) => {
                root.movie-open-similar(id);
            }
            open-person(id) => {
                root.movie-open-person(id);
            }
            open-collection(index) => {
                root.movie-open-collection(index);
            }
            back => {
                root.back();
            }
            open-tab(page) => {
                root.open-tab(page);
            }
            open-settings => {
                root.open-settings();
            }
        }

        if root.screen == Screen.series: SeriesScreen {
            active: root.screen == Screen.series;
            viewport-y <=> root.series-viewport-y;
            page: root.top-bar-page;
            loaded: root.series-loaded;
            loading: root.series-loading;
            error: root.series-error;
            series: root.series-data;
            poster: root.series-poster;
            backdrop: root.series-backdrop;
            busy: root.series-busy;
            seasons: root.series-seasons;
            season-ids: root.series-season-ids;
            season: root.series-season;
            episodes: root.series-episodes;
            episodes-loading: root.series-episodes-loading;
            episodes-stale: root.series-episodes-stale;
            episodes-error: root.series-episodes-error;
            people: root.series-people;
            similar: root.series-similar;
            play => {
                root.series-play();
            }
            play-episode(id) => {
                root.series-play-episode(id);
            }
            select-season(index) => {
                root.series-select-season(index);
            }
            toggle-watched => {
                root.series-toggle-watched();
            }
            toggle-favorite => {
                root.series-toggle-favorite();
            }
            retry => {
                root.series-retry();
            }
            retry-episodes => {
                root.series-retry-episodes();
            }
            open-item(id) => {
                root.series-open-similar(id);
            }
            open-person(id) => {
                root.series-open-person(id);
            }
            back => {
                root.back();
            }
            open-tab(page) => {
                root.open-tab(page);
            }
            open-settings => {
                root.open-settings();
            }
        }

        if root.screen == Screen.person: PersonScreen {
            page: root.top-bar-page;
            loaded: root.person-loaded;
            loading: root.person-loading;
            error: root.person-error;
            person: root.person-data;
            photo: root.person-photo;
            has-photo: root.person-has-photo;
            titles: root.person-titles;
            filter: root.person-filter;
            expanded <=> root.person-expanded;
            viewport-y <=> root.person-viewport-y;
            select-filter(filter) => {
                root.person-select-filter(filter);
            }
            open-item(id) => {
                root.person-open(id);
            }
            retry => {
                root.person-retry();
            }
            back => {
                root.back();
            }
            open-tab(page) => {
                root.open-tab(page);
            }
            open-settings => {
                root.open-settings();
            }
        }

        if root.screen == Screen.collection: CollectionScreen {
            active: root.screen == Screen.collection;
            viewport-y <=> root.collection-viewport-y;
            page: root.top-bar-page;
            loaded: root.collection-loaded;
            loading: root.collection-loading;
            error: root.collection-error;
            collection: root.collection-data;
            poster: root.collection-poster;
            backdrop: root.collection-backdrop;
            busy: root.collection-busy;
            items: root.collection-items;
            play => {
                root.collection-play();
            }
            toggle-watched => {
                root.collection-toggle-watched();
            }
            toggle-favorite => {
                root.collection-toggle-favorite();
            }
            open-item(id) => {
                root.collection-open(id);
            }
            retry => {
                root.collection-retry();
            }
            back => {
                root.back();
            }
            open-tab(page) => {
                root.open-tab(page);
            }
            open-settings => {
                root.open-settings();
            }
        }

        if root.screen == Screen.player: PlayerScreen {
            title: root.player-title;
            subtitle: root.player-subtitle;
            loading: root.player-loading;
            has-error: root.player-has-error;
            error: root.player-error;
            video-active: root.player-video-active;
            position: root.player-position;
            duration: root.player-duration;
            elapsed: root.player-elapsed;
            total: root.player-total;
            remaining: root.player-remaining;
            time-remaining <=> root.player-time-remaining;
            time-remaining-changed(remaining) => {
                root.player-time-remaining-changed(remaining);
            }
            paused: root.player-paused;
            volume: root.player-volume;
            muted: root.player-muted;
            speed: root.player-speed;
            speeds: root.player-speeds;
            qualities: root.player-qualities;
            quality: root.player-quality;
            has-next: root.player-has-next;
            audio: root.player-audio;
            subtitles: root.player-subtitles;
            audio-delay: root.player-audio-delay;
            subtitle-delay: root.player-subtitle-delay;
            chapters: root.player-chapters;
            current-chapter: root.player-current-chapter;
            chapter-marks: root.player-chapter-marks;
            next-up: root.player-next-up;
            skip-kind: root.player-skip-kind;
            skip-end: root.player-skip-end;
            skipped: root.player-skipped;
            fullscreen: root.full-screen;
            fullscreen-own: root.player-fullscreen-own;
            scrubbing <=> root.player-scrubbing;
            preview: root.player-preview;
            stats: root.player-stats;
            stats-visible <=> root.player-stats-visible;
            preview-requested(seconds) => {
                root.player-preview-requested(seconds);
            }
            back => {
                root.player-command-stop();
                root.close-player();
            }
            toggle-fullscreen => {
                root.toggle-fullscreen();
            }
            cursor-hidden(x, y) => {
                root.player-cursor-hidden(x, y);
            }
            command-retry => {
                root.player-command-retry();
            }
            command-set-paused(paused) => {
                root.player-command-set-paused(paused);
            }
            command-seek(seconds) => {
                root.player-command-seek(seconds);
            }
            command-skip(direction) => {
                root.player-command-skip(direction);
            }
            command-previous => {
                root.player-command-previous();
            }
            command-next => {
                root.player-command-next();
            }
            command-play-next-now => {
                root.player-command-play-next-now();
            }
            command-cancel-next-up => {
                root.player-command-cancel-next-up();
            }
            command-undo-skip => {
                root.player-command-undo-skip();
            }
            command-skip-segment => {
                root.player-command-skip-segment();
            }
            command-set-speed(speed) => {
                root.player-command-set-speed(speed);
            }
            command-step-speed(direction) => {
                root.player-command-step-speed(direction);
            }
            command-set-quality(index) => {
                root.player-command-set-quality(index);
            }
            command-set-volume(volume) => {
                root.player-command-set-volume(volume);
            }
            command-step-volume(direction) => {
                root.player-command-step-volume(direction);
            }
            command-set-muted(muted) => {
                root.player-command-set-muted(muted);
            }
            command-select-audio(index) => {
                root.player-command-select-audio(index);
            }
            command-select-subtitle(index) => {
                root.player-command-select-subtitle(index);
            }
            command-step-audio-delay(direction) => {
                root.player-command-step-audio-delay(direction);
            }
            command-set-audio-delay(ms) => {
                root.player-command-set-audio-delay(ms);
            }
            command-step-subtitle-delay(direction) => {
                root.player-command-step-subtitle-delay(direction);
            }
            command-set-subtitle-delay(ms) => {
                root.player-command-set-subtitle-delay(ms);
            }
            command-step-chapter(direction) => {
                root.player-command-step-chapter(direction);
            }
            command-stats => {
                root.player-command-stats();
            }
        }

        if root.screen == Screen.settings: SettingsScreen {
            open-tab(page) => {
                root.open-tab(page);
            }
            server-name: root.settings-server-name;
            server-address: root.settings-server-address;
            user-name: root.settings-user-name;
            token-store: root.settings-token-store;
            subtitles: root.settings-subtitles;
            subtitles-changed(choice) => {
                root.settings-subtitles-changed(choice);
            }
            start-fullscreen: root.settings-start-fullscreen;
            start-fullscreen-changed(on) => {
                root.settings-start-fullscreen-changed(on);
            }
            discord: root.settings-discord;
            discord-changed(on) => {
                root.settings-discord-changed(on);
            }
            playback: root.settings-playback;
            playback-changed(choice) => {
                root.settings-playback-changed(choice);
            }
            authorize-code <=> root.settings-authorize-code;
            authorize-state <=> root.settings-authorize-state;
            code-ready(code) => {
                return root.settings-code-ready(code);
            }
            authorize(code) => {
                root.settings-authorize(code);
            }
            image-cache-kb: root.settings-image-cache-kb;
            clear-image-cache => {
                root.settings-clear-image-cache();
            }
            logs-copied: root.settings-logs-copied;
            logs-copy-failed: root.settings-logs-copy-failed;
            copy-logs => {
                root.settings-copy-logs();
            }
            open-logs => {
                root.settings-open-logs();
            }
            version: root.app-version;
            back => {
                root.close-settings();
            }
            sign-out => {
                root.sign-out();
            }
        }

        HoverCardOverlay { }

        ContextMenuOverlay { }

        // Below the top bar of the screens that have one.
        if root.notice.visible: NoticeBanner {
            y: root.screen == Screen.home || root.screen == Screen.library || root.screen == Screen.search || root.screen == Screen.movie || root.screen == Screen.series || root.screen == Screen.person || root.screen == Screen.collection || root.screen == Screen.settings ? Theme.space-3xl + Theme.space-lg : Theme.space-lg;
            x: (parent.width - self.width) / 2;
            width: min(parent.width - 2 * Theme.space-lg, 560px);
            notice: root.notice;
            dismiss => {
                root.dismiss-notice();
            }
            undo => {
                root.undo-notice();
            }
        }

        ShortcutsOverlay { }
    }

    // Hands text to the system clipboard, which Slint reaches only through a text input.
    clipboard := TextInput {
        visible: false;
        enabled: false;
        read-only: true;
        single-line: false;
        width: 0;
        height: 0;
    }

    // Puts `text` on the clipboard and tells whether it got there: the platform reports no
    // failure, so the clipboard is read back.
    public function copy-to-clipboard(text: string) -> bool {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.text = "";
        clipboard.paste();
        let copied = clipboard.text == text;
        clipboard.text = "";
        copied
    }
}
