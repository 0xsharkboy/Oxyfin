import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import { Theme, Message, Messages, NextUp, TrackRow } from "theme.slint";
import { StartingScreen } from "screens/starting.slint";
import { SignInScreen, ServerState, ServerStatus } from "screens/sign_in.slint";
import { QuickConnectScreen } from "screens/quick_connect.slint";
import { HomeScreen, HomeBanner, HomeRow, HomeRowKind, HomeTitles } from "screens/home.slint";
import { PlayerScreen } from "screens/player.slint";
import { SettingsScreen } from "screens/settings.slint";
import { NoticeBanner, NoticeData } from "components/notice_banner.slint";

export { CardData, Message, Messages, NextUp, TrackRow } from "theme.slint";
export { ServerState, ServerStatus }
export { HomeBanner, HomeRow, HomeRowKind, HomeTitles }
export { NoticeData }

// Mirrors the Rust `state::Screen` one to one.
export enum Screen { starting, sign-in, quick-connect, home, library, search, movie, series, player, settings }

export component AppWindow inherits Window {
    in property <Screen> screen: Screen.starting;

    in-out property <string> server-address;
    in-out property <string> username;
    in property <ServerStatus> server-status;
    in property <bool> busy;
    in property <string> form-error;
    callback server-changed(address: string);
    callback server-confirmed(address: string);
    callback sign-in(username: string, password: string);
    callback open-quick-connect();

    in property <string> quick-connect-code;
    in property <[string]> quick-connect-digits;
    in property <string> quick-connect-error;
    in property <bool> quick-connect-can-retry;
    callback cancel-quick-connect();
    callback retry-quick-connect();

    in property <HomeBanner> home-banner;
    in property <[HomeRow]> home-rows;
    in property <bool> home-settled;
    callback play(id: string);
    callback open-settings();

    in property <string> player-title;
    in property <string> player-subtitle;
    in property <bool> player-loading;
    in property <bool> player-has-error;
    in property <Message> player-error;
    in property <bool> player-video-active;
    in property <float> player-position;
    in property <float> player-duration;
    in property <string> player-elapsed;
    in property <string> player-total;
    in property <bool> player-paused;
    in property <float> player-volume: 100;
    in property <bool> player-muted;
    in property <float> player-speed: 1;
    in property <[float]> player-speeds;
    in property <bool> player-has-next;
    in property <[TrackRow]> player-audio;
    in property <[TrackRow]> player-subtitles;
    in property <NextUp> player-next-up;
    // Set while a seek is on its way; the position is frozen until the player confirms it.
    in property <bool> player-seek-pending;
    in-out property <bool> player-scrubbing;
    callback player-toggle-fullscreen();
    callback player-cursor-hidden(x: length, y: length);
    callback player-command-stop();
    callback player-command-set-paused(paused: bool);
    callback player-command-seek(seconds: float);
    callback player-command-skip(direction: int);
    callback player-command-previous();
    callback player-command-next();
    callback player-command-play-next-now();
    callback player-command-cancel-next-up();
    callback player-command-set-speed(speed: float);
    callback player-command-step-speed(direction: int);
    callback player-command-set-volume(volume: float);
    callback player-command-step-volume(direction: int);
    callback player-command-set-muted(muted: bool);
    callback player-command-select-audio(index: int);
    callback player-command-select-subtitle(index: int);
    callback close-player();

    in property <string> settings-server-name;
    in property <string> settings-server-address;
    in property <string> settings-user-name;
    in property <bool> settings-token-in-file;
    in property <string> app-version;
    callback close-settings();
    callback sign-out();

    in property <NoticeData> notice;
    callback dismiss-notice();

    title: "Oxyfin";
    background: transparent;
    default-font-family: "Inter";
    preferred-width: 1280px;
    preferred-height: 720px;

    // The video is drawn under the interface, so the player screen leaves the window transparent.
    if root.screen != Screen.player: Rectangle {
        background: Theme.bg-base;
    }

    if root.screen == Screen.starting: StartingScreen { }

    if root.screen == Screen.sign-in: SignInScreen {
        server-address <=> root.server-address;
        username <=> root.username;
        server-status: root.server-status;
        busy: root.busy;
        form-error: root.form-error;
        server-changed(address) => {
            root.server-changed(address);
        }
        server-confirmed(address) => {
            root.server-confirmed(address);
        }
        sign-in(username, password) => {
            root.sign-in(username, password);
        }
        open-quick-connect => {
            root.open-quick-connect();
        }
    }

    if root.screen == Screen.quick-connect: QuickConnectScreen {
        code: root.quick-connect-code;
        digits: root.quick-connect-digits;
        error: root.quick-connect-error;
        can-retry: root.quick-connect-can-retry;
        cancel => {
            root.cancel-quick-connect();
        }
        retry => {
            root.retry-quick-connect();
        }
    }

    if root.screen == Screen.home: HomeScreen {
        banner: root.home-banner;
        rows: root.home-rows;
        settled: root.home-settled;
        play(id) => {
            root.play(id);
        }
        open-settings => {
            root.open-settings();
        }
    }

    if root.screen == Screen.player: PlayerScreen {
        title: root.player-title;
        subtitle: root.player-subtitle;
        loading: root.player-loading;
        has-error: root.player-has-error;
        error: root.player-error;
        video-active: root.player-video-active;
        position: root.player-position;
        duration: root.player-duration;
        elapsed: root.player-elapsed;
        total: root.player-total;
        paused: root.player-paused;
        volume: root.player-volume;
        muted: root.player-muted;
        speed: root.player-speed;
        speeds: root.player-speeds;
        has-next: root.player-has-next;
        audio: root.player-audio;
        subtitles: root.player-subtitles;
        next-up: root.player-next-up;
        fullscreen: root.full-screen;
        scrubbing <=> root.player-scrubbing;
        back => {
            root.player-command-stop();
            root.close-player();
        }
        toggle-fullscreen => {
            root.player-toggle-fullscreen();
        }
        cursor-hidden(x, y) => {
            root.player-cursor-hidden(x, y);
        }
        command-set-paused(paused) => {
            root.player-command-set-paused(paused);
        }
        command-seek(seconds) => {
            root.player-command-seek(seconds);
        }
        command-skip(direction) => {
            root.player-command-skip(direction);
        }
        command-previous => {
            root.player-command-previous();
        }
        command-next => {
            root.player-command-next();
        }
        command-play-next-now => {
            root.player-command-play-next-now();
        }
        command-cancel-next-up => {
            root.player-command-cancel-next-up();
        }
        command-set-speed(speed) => {
            root.player-command-set-speed(speed);
        }
        command-step-speed(direction) => {
            root.player-command-step-speed(direction);
        }
        command-set-volume(volume) => {
            root.player-command-set-volume(volume);
        }
        command-step-volume(direction) => {
            root.player-command-step-volume(direction);
        }
        command-set-muted(muted) => {
            root.player-command-set-muted(muted);
        }
        command-select-audio(index) => {
            root.player-command-select-audio(index);
        }
        command-select-subtitle(index) => {
            root.player-command-select-subtitle(index);
        }
    }

    if root.screen == Screen.settings: SettingsScreen {
        server-name: root.settings-server-name;
        server-address: root.settings-server-address;
        user-name: root.settings-user-name;
        token-in-file: root.settings-token-in-file;
        version: root.app-version;
        back => {
            root.close-settings();
        }
        sign-out => {
            root.sign-out();
        }
    }

    // Below the top bar of the screens that have one.
    if root.notice.visible: NoticeBanner {
        y: root.screen == Screen.home || root.screen == Screen.settings ? Theme.space-3xl + Theme.space-lg : Theme.space-lg;
        x: (parent.width - self.width) / 2;
        width: min(parent.width - 2 * Theme.space-lg, 560px);
        notice: root.notice;
        dismiss => {
            root.dismiss-notice();
        }
    }
}
