import { Theme } from "../theme.slint";

// Thin playback or resume progress; `value` goes from 0 to 1.
export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <string> label;

    accessible-role: progress-indicator;
    accessible-label: label;
    accessible-value: round(clamp(value, 0, 1) * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;

    height: 4px;
    border-radius: Theme.radius-full;
    background: Theme.progress-track;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        background: Theme.accent;
    }
}
