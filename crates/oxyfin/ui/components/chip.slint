import { Theme } from "../theme.slint";
import { ContextMenu, MenuKeys } from "context_menu.slint";
import { LabelText } from "text.slint";

// Filter, sort or genre pill; selected chips are filled with the accent.
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    // Item whose context menu a right click or the menu keys open; empty for none.
    in property <string> menu-id;
    callback clicked();

    // Takes the focus back after a row of its menu chosen from the keyboard, also once rebuilt.
    property <bool> focus-return: root.menu-id != "" && ContextMenu.focus-id == root.menu-id;
    // Answers the window while it holds that focus.
    property <int> focus-check: focus.has-focus && root.focus-return ? ContextMenu.focus-check : -1;

    changed focus-check => {
        if root.focus-check >= 0 {
            ContextMenu.focus-answer = root.focus-check;
        }
    }
    init => {
        if root.focus-return {
            focus.focus();
        }
    }

    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => {
        activate();
    }
    forward-focus: focus;

    border-radius: Theme.radius-full;
    background: selected ? Theme.accent : (touch.has-hover && enabled ? Theme.bg-hover : Theme.bg-elevated);
    border-width: focus.has-focus ? Theme.border-focus : (selected ? 0 : Theme.border-thin);
    border-color: focus.has-focus ? (selected ? Theme.text-primary : Theme.accent) : Theme.border-default;
    opacity: enabled ? 1 : Theme.disabled-opacity;

    function activate() {
        if enabled {
            clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.menu-id != "" {
                ContextMenu.show(root.menu-id, false, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false, root.label, "");
            }
        }
        clicked => {
            focus.focus();
            root.activate();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        // Clicks go to the TouchArea: a focusing FocusScope on top would swallow the first one.
        focus-on-click: false;
        focus-gained => {
            if !root.focus-return {
                ContextMenu.focus-id = "";
            }
        }
        focus-lost => {
            if root.focus-return {
                ContextMenu.focus-id = "";
            }
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            if MenuKeys.opens(event) && root.menu-id != "" {
                ContextMenu.show(root.menu-id, false, root.absolute-position.x + Theme.space-lg, root.absolute-position.y + Theme.space-lg, true, root.label, "");
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        padding-top: Theme.space-chip-y;
        padding-bottom: Theme.space-chip-y;
        spacing: Theme.space-xs;

        LabelText {
            accessible-role: none;
            text: root.label;
            color: root.selected ? Theme.text-on-accent : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
}
