import { Theme } from "../theme.slint";
import { ContextMenu, MenuKeys } from "context_menu.slint";
import { Icons } from "../icons.slint";
import { CardStatus } from "card.slint";
import { ProgressBar } from "progress_bar.slint";
import { BodyStrongText, BodyText, HeadingText, LabelText } from "text.slint";

// One episode of a season: number, thumbnail with its watched badge or resume bar,
// title, summary cut after two lines, and duration.
export component EpisodeRow inherits Rectangle {
    in property <string> number;
    in property <string> title;
    in property <string> overview;
    // Length in minutes; 0 when unknown.
    in property <int> minutes;
    in property <image> image;
    in property <CardStatus> status: CardStatus.default;
    in property <float> progress;
    // Item whose context menu a right click or the menu keys open; empty for none.
    in property <string> menu-id;
    callback clicked();

    // Takes the focus back after a row of its menu chosen from the keyboard, also once rebuilt.
    property <bool> focus-return: root.menu-id != "" && ContextMenu.focus-id == root.menu-id;
    // Answers the window while it holds that focus.
    property <int> focus-check: focus.has-focus && root.focus-return ? ContextMenu.focus-check : -1;

    changed focus-check => {
        if root.focus-check >= 0 {
            ContextMenu.focus-answer = root.focus-check;
        }
    }
    init => {
        if root.focus-return {
            focus.focus();
        }
    }

    accessible-role: button;
    accessible-label: title;
    accessible-description: overview;
    accessible-action-default => {
        activate();
    }
    forward-focus: focus;

    preferred-height: layout.preferred-height;
    border-radius: Theme.radius-md;
    background: touch.has-hover || focus.has-focus ? Theme.bg-hover : transparent;

    function activate() {
        clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.menu-id != "" {
                ContextMenu.show(root.menu-id, false, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false, root.title, "");
            }
        }
        clicked => {
            focus.focus();
            root.activate();
        }
    }

    focus := FocusScope {
        // Clicks go to the TouchArea: a focusing FocusScope on top would swallow the first one.
        focus-on-click: false;
        focus-gained => {
            if !root.focus-return {
                ContextMenu.focus-id = "";
            }
        }
        focus-lost => {
            if root.focus-return {
                ContextMenu.focus-id = "";
            }
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            if MenuKeys.opens(event) && root.menu-id != "" {
                ContextMenu.show(root.menu-id, false, root.absolute-position.x + Theme.space-lg, root.absolute-position.y + Theme.space-lg, true, root.title, "");
                return accept;
            }
            reject
        }
    }

    layout := HorizontalLayout {
        padding-top: Theme.space-md;
        padding-bottom: Theme.space-md;
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-lg;

        VerticalLayout {
            width: Theme.space-2xl;
            alignment: center;

            HeadingText {
                accessible-role: none;
                text: root.number;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }

        thumb := Rectangle {
            width: Theme.episode-thumb-width;
            height: Theme.episode-thumb-height;
            border-radius: Theme.radius-md;
            background: Theme.landscape-placeholder;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.image;
                image-fit: cover;
            }

            if root.status == CardStatus.in-progress: ProgressBar {
                x: Theme.space-sm;
                y: parent.height - Theme.space-sm - self.height;
                width: parent.width - 2 * Theme.space-sm;
                value: root.progress;
            }

            if root.status == CardStatus.watched: Rectangle {
                x: parent.width - Theme.space-sm - self.width;
                y: Theme.space-sm;
                width: 16px + 2 * Theme.space-xs;
                height: self.width;
                border-radius: Theme.radius-full;
                background: Theme.watched;

                Image {
                    width: 16px;
                    height: 16px;
                    source: Icons.check;
                    colorize: Theme.text-on-accent;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Theme.episode-text-gap;

            HorizontalLayout {
                spacing: Theme.space-lg;

                title-text := BodyStrongText {
                    accessible-role: none;
                    text: root.title;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.minutes > 0: duration := LabelText {
                    accessible-role: none;
                    text: @tr("{} min", root.minutes);
                    color: Theme.text-muted;
                    horizontal-stretch: 0;
                }
            }
            if root.overview != "": overview-text := BodyText {
                accessible-role: none;
                text: root.overview;
                color: Theme.text-secondary;
                wrap: word-wrap;
                overflow: elide;
                // A wrapped text asks for all its lines as its minimum, which would win over the maximum.
                min-height: 0px;
                max-height: 2 * Theme.body-line-height;
            }
        }
    }
}
