import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { HeadingText } from "text.slint";
import { NavItem } from "nav_item.slint";
import { IconButton } from "icon_button.slint";

export enum TopBarPage { home, movies, shows, favorites, search, none }

// Top navigation drawn over the page banner, solid once the page scrolls under it.
export component TopBar inherits Rectangle {
    in property <TopBarPage> current: TopBarPage.home;
    in property <bool> settings-active;
    // How far the page has scrolled under the bar; the scrim alone lets content show through the tabs.
    in property <length> scrolled-by;
    callback home-clicked();
    callback movies-clicked();
    callback shows-clicked();
    callback favorites-clicked();
    callback search-clicked();
    callback settings-clicked();

    accessible-role: tab-list;
    accessible-label: @tr("Navigation");

    background: Theme.top-bar-scrim;

    backing := Rectangle {
        background: Theme.bg-base;
        opacity: clamp(root.scrolled-by / root.height, 0, 1);
    }

    HorizontalLayout {
        padding-top: Theme.space-sm;
        padding-left: Theme.space-2xl;
        padding-right: Theme.space-2xl;
        spacing: Theme.space-sm;

        HorizontalLayout {
            padding-right: Theme.space-xl;
            spacing: Theme.space-sm;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: Icons.logo;
                    width: 22px;
                    height: 22px;
                }
            }
            HeadingText {
                // Brand name, not translated.
                text: "Oxyfin";
                vertical-alignment: center;
            }
        }

        NavItem {
            label: @tr("Home");
            active: root.current == TopBarPage.home;
            clicked => {
                root.home-clicked();
            }
        }
        NavItem {
            label: @tr("Movies");
            active: root.current == TopBarPage.movies;
            clicked => {
                root.movies-clicked();
            }
        }
        NavItem {
            label: @tr("Shows");
            active: root.current == TopBarPage.shows;
            clicked => {
                root.shows-clicked();
            }
        }
        NavItem {
            label: @tr("Favorites");
            active: root.current == TopBarPage.favorites;
            clicked => {
                root.favorites-clicked();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.search;
                label: @tr("Search");
                active: root.current == TopBarPage.search;
                clicked => {
                    root.search-clicked();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.settings;
                label: @tr("Settings");
                active: root.settings-active;
                clicked => {
                    root.settings-clicked();
                }
            }
        }
    }
}
