import { Theme, StatSection } from "../theme.slint";
import { BodyStrongText, CaptionText, LabelText } from "text.slint";

// Words of the playback statistics, read by the binary to build the rows in the user's language.
export global StatsTitles {
    public pure function playback() -> string {
        @tr("Playback")
    }
    public pure function video() -> string {
        @tr("Video")
    }
    public pure function audio() -> string {
        @tr("Audio")
    }
    public pure function network() -> string {
        @tr("Network")
    }
    public pure function method() -> string {
        @tr("Method")
    }
    public pure function container() -> string {
        @tr("Container")
    }
    public pure function bitrate() -> string {
        @tr("Bitrate")
    }
    public pure function codec() -> string {
        @tr("Codec")
    }
    public pure function resolution() -> string {
        @tr("Resolution")
    }
    public pure function frame-rate() -> string {
        @tr("Frame rate")
    }
    public pure function dropped-frames() -> string {
        @tr("Dropped frames")
    }
    public pure function hdr() -> string {
        @tr("HDR")
    }
    public pure function output() -> string {
        @tr("Output")
    }
    public pure function buffer() -> string {
        @tr("Buffer")
    }
    public pure function speed() -> string {
        @tr("Speed")
    }
    public pure function direct-play() -> string {
        @tr("Direct play")
    }
    public pure function direct-stream() -> string {
        @tr("Direct stream")
    }
    public pure function transcode() -> string {
        @tr("Transcode")
    }
    public pure function software() -> string {
        @tr("software")
    }
    public pure function hardware(api: string) -> string {
        @tr("hardware: {}", api)
    }
    public pure function dropped(decoder: string, output: string) -> string {
        @tr("{} decoder · {} output", decoder, output)
    }
    public pure function ahead(seconds: string) -> string {
        @tr("{} s ahead", seconds)
    }
    public pure function tone-mapped(format: string) -> string {
        @tr("{}, tone mapped", format)
    }
    public pure function tone-mapped-with(format: string, curve: string) -> string {
        @tr("{}, tone mapped ({})", format, curve)
    }
    // A short phrase for a reason the server gives to transcode, as Jellyfin names it; an
    // unknown one stays as it is.
    public pure function transcode-reason(reason: string) -> string {
        if reason == "ContainerNotSupported" {
            return @tr("container not supported");
        }
        if reason == "VideoCodecNotSupported" {
            return @tr("video codec not supported");
        }
        if reason == "AudioCodecNotSupported" {
            return @tr("audio codec not supported");
        }
        if reason == "SubtitleCodecNotSupported" {
            return @tr("subtitle format not supported");
        }
        if reason == "AudioIsExternal" {
            return @tr("external audio");
        }
        if reason == "SecondaryAudioNotSupported" {
            return @tr("secondary audio not supported");
        }
        if reason == "StreamCountExceedsLimit" {
            return @tr("too many streams");
        }
        if reason == "VideoProfileNotSupported" {
            return @tr("video profile not supported");
        }
        if reason == "VideoRangeTypeNotSupported" {
            return @tr("HDR type not supported");
        }
        if reason == "VideoCodecTagNotSupported" {
            return @tr("video codec tag not supported");
        }
        if reason == "VideoLevelNotSupported" {
            return @tr("video level not supported");
        }
        if reason == "VideoResolutionNotSupported" {
            return @tr("resolution not supported");
        }
        if reason == "VideoBitDepthNotSupported" {
            return @tr("video bit depth not supported");
        }
        if reason == "VideoFramerateNotSupported" {
            return @tr("frame rate not supported");
        }
        if reason == "VideoRotationNotSupported" {
            return @tr("video rotation not supported");
        }
        if reason == "RefFramesNotSupported" {
            return @tr("reference frames not supported");
        }
        if reason == "AnamorphicVideoNotSupported" {
            return @tr("anamorphic video not supported");
        }
        if reason == "InterlacedVideoNotSupported" {
            return @tr("interlaced video not supported");
        }
        if reason == "AudioChannelsNotSupported" {
            return @tr("audio channels not supported");
        }
        if reason == "AudioProfileNotSupported" {
            return @tr("audio profile not supported");
        }
        if reason == "AudioSampleRateNotSupported" {
            return @tr("audio sample rate not supported");
        }
        if reason == "AudioBitDepthNotSupported" {
            return @tr("audio bit depth not supported");
        }
        if reason == "ContainerBitrateExceedsLimit" {
            return @tr("bitrate over the limit");
        }
        if reason == "VideoBitrateNotSupported" {
            return @tr("video bitrate over the limit");
        }
        if reason == "AudioBitrateNotSupported" {
            return @tr("audio bitrate over the limit");
        }
        if reason == "UnknownVideoStreamInfo" {
            return @tr("unknown video stream");
        }
        if reason == "UnknownAudioStreamInfo" {
            return @tr("unknown audio stream");
        }
        if reason == "DirectPlayError" {
            return @tr("direct play failed");
        }
        reason
    }
}

// Playback statistics menu of the player, above its button: sections of label and value rows.
export component StatsPanel inherits Rectangle {
    in property <[StatSection]> sections;

    accessible-role: groupbox;
    accessible-label: @tr("Playback statistics");

    width: Theme.stats-panel-width;
    height: content.preferred-height;
    background: Theme.bg-elevated;
    border-radius: Theme.radius-lg;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;
    drop-shadow-offset-y: 12px;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.menu-shadow;

    // Clicks on the panel must not reach the player behind it.
    TouchArea { }

    content := VerticalLayout {
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;

        HorizontalLayout {
            padding-left: Theme.space-lg;
            padding-right: Theme.space-lg;
            padding-top: Theme.space-sm;
            padding-bottom: Theme.space-xs;
            spacing: Theme.space-md;

            BodyStrongText {
                text: @tr("Playback statistics");
                horizontal-stretch: 1;
                overflow: elide;
            }

            CaptionText {
                text: @tr("I to close");
                vertical-alignment: center;
            }
        }

        for section in root.sections: VerticalLayout {
            HorizontalLayout {
                padding-left: Theme.space-lg;
                padding-right: Theme.space-lg;
                padding-top: Theme.space-sm;
                padding-bottom: Theme.space-xs;

                LabelText {
                    text: section.title.to-uppercase();
                    color: Theme.text-muted;
                }
            }

            for row in section.rows: HorizontalLayout {
                padding-left: Theme.space-lg;
                padding-right: Theme.space-lg;
                padding-top: Theme.stats-row-padding-y;
                padding-bottom: Theme.stats-row-padding-y;
                spacing: Theme.space-md;

                CaptionText {
                    width: Theme.stats-label-width;
                    text: row.label;
                    color: Theme.text-secondary;
                    overflow: elide;
                }

                // A fixed width, so that the height of a wrapped value counts in the panel height.
                CaptionText {
                    width: root.width - 2 * Theme.space-lg - Theme.stats-label-width - Theme.space-md;
                    text: row.value;
                    color: row.warn ? Theme.warning : row.good ? Theme.watched : Theme.text-primary;
                    wrap: word-wrap;
                }
            }
        }
    }
}
