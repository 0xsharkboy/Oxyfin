import { Theme, SeekPreview, Messages } from "../theme.slint";
import { BodyStrongText, CaptionText } from "text.slint";

// Popup above the seek bar: the thumbnail of the hovered time, when the item has some, then a
// label with the name of its chapter, when the item has chapters, over the time.
export component SeekPreviewPopup inherits Rectangle {
    in property <SeekPreview> preview;

    property <length> thumb-width: Theme.seek-preview-width;
    property <length> thumb-height: root.preview.width > 0 ? root.thumb-width * root.preview.height / root.preview.width : 0;

    accessible-role: groupbox;
    accessible-label: @tr("Seek preview");

    // A long chapter name is elided rather than widening the popup past the thumbnail.
    width: root.preview.has-image ? root.thumb-width : min(label.preferred-width, root.thumb-width);
    height: column.preferred-height;

    column := VerticalLayout {
        spacing: Theme.space-sm;
        alignment: end;

        if root.preview.has-image: Rectangle {
            width: root.thumb-width;
            height: root.thumb-height;
            border-radius: Theme.radius-md;
            clip: true;

            Image {
                width: parent.width;
                height: parent.height;
                source: root.preview.image;
                source-clip-x: root.preview.x;
                source-clip-y: root.preview.y;
                source-clip-width: root.preview.width;
                source-clip-height: root.preview.height;
                image-fit: fill;
            }

            Rectangle {
                border-radius: Theme.radius-md;
                border-width: Theme.border-thin;
                border-color: Theme.border-default;
            }
        }

        HorizontalLayout {
            alignment: center;

            label := Rectangle {
                width: min(self.preferred-width, root.width);
                background: Theme.bg-elevated;
                border-radius: Theme.radius-sm;

                VerticalLayout {
                    padding-left: Theme.seek-label-padding-x;
                    padding-right: Theme.seek-label-padding-x;
                    padding-top: Theme.space-chip-y;
                    padding-bottom: Theme.space-chip-y;
                    spacing: Theme.space-2xs;

                    if root.preview.chapter-number > 0: BodyStrongText {
                        accessible-role: text;
                        text: Messages.chapter-title(root.preview.chapter, root.preview.chapter-number);
                        horizontal-alignment: center;
                        overflow: elide;
                    }

                    CaptionText {
                        accessible-role: text;
                        text: root.preview.time;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
