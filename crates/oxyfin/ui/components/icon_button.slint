import { Theme } from "../theme.slint";
import { MouseBack } from "mouse_back.slint";
import { ContextMenu } from "context_menu.slint";
import { Icons } from "../icons.slint";

// Round icon button of the top bar and the player; `label` is announced by screen readers.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    // False where a click must leave the keyboard focus where it is.
    in property <bool> focus-on-click: true;
    // Highlighted while what it opens is shown.
    in property <bool> active;
    in property <color> icon-color: Theme.text-primary;
    callback clicked();

    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => {
        activate();
    }
    forward-focus: focus;

    width: 24px + 2 * Theme.space-sm;
    height: self.width;
    border-radius: Theme.radius-full;
    background: (root.active || touch.has-hover || focus.has-focus) && enabled ? Theme.bg-hover : transparent;
    border-width: focus.has-focus ? Theme.border-focus : 0;
    border-color: Theme.accent;
    opacity: enabled ? 1 : Theme.disabled-opacity;

    function activate() {
        if enabled {
            clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            MouseBack.handle(event);
        }
        clicked => {
            if root.focus-on-click {
                focus.focus();
            }
            root.activate();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        // Clicks go to the TouchArea: a focusing FocusScope on top would swallow the first one.
        focus-on-click: false;
        focus-gained => {
            ContextMenu.focus-taken();
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            reject
        }
    }

    Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        colorize: Icons.tint(root.icon-color);
    }
}
