import { QualityRow } from "../theme.slint";
import { MenuPanel, MenuHeader, MenuDivider, MenuOption } from "track_menu.slint";

// Playback settings menu of the player: speed and streaming quality. The speed follows what the
// player reports; the quality is the choice the user made.
export component SpeedMenu inherits MenuPanel {
    in property <[float]> speeds;
    in property <float> speed;
    in property <[QualityRow]> qualities;
    in property <int> quality;
    callback select(speed: float);
    callback select-quality(index: int);

    accessible-role: list;
    accessible-label: @tr("Playback settings");

    MenuHeader {
        text: @tr("SPEED");
    }

    for value in root.speeds: MenuOption {
        label: value == 1 ? @tr("Normal") : @tr("{}×", value);
        selected: abs(value - root.speed) < 0.001;
        chosen => {
            root.select(value);
        }
    }

    MenuDivider { }

    MenuHeader {
        text: @tr("QUALITY");
    }

    for row[index] in root.qualities: MenuOption {
        label: row.height == 0 ? @tr("Original") : @tr("{}p", row.height);
        detail: row.kbps == 0 ? "" : row.kbps >= 1000 ? @tr("{} Mbps", row.kbps / 1000) : @tr("{} kbps", row.kbps);
        selected: index == root.quality;
        chosen => {
            root.select-quality(index);
        }
    }
}
