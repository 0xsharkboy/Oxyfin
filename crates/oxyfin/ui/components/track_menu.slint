import { Theme, TrackRow, Messages } from "../theme.slint";
import { Icons } from "../icons.slint";
import { BodyStrongText, BodyText, CaptionText, LabelText } from "text.slint";

// Floating panel of the player menus; scrolls when its options outgrow `limit`.
export component MenuPanel inherits Rectangle {
    in property <length> limit: 400px;
    // The panel grows up to this width to fit its widest option; wider ones are elided.
    in property <length> widest: Theme.menu-width;
    // Vertical offset of the options, negative once scrolled down.
    in-out property <length> scroll-y;
    // Height the options are shown in.
    out property <length> visible-height: self.height - 2 * Theme.space-sm;
    out property <length> content-height: content.preferred-height;

    width: max(Theme.menu-width, min(content.preferred-width, root.widest));
    height: min(content.preferred-height + 2 * Theme.space-sm, root.limit);
    background: Theme.bg-elevated;
    border-radius: Theme.radius-lg;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;
    drop-shadow-offset-y: 8px;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.menu-shadow;

    // Clicks between the options must not reach the player behind the panel.
    TouchArea { }

    Flickable {
        mouse-drag-pan-enabled: false;
        x: 0;
        y: Theme.space-sm;
        width: parent.width;
        height: root.visible-height;
        content-y <=> root.scroll-y;
        content-width: self.width;
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: root.width;
            alignment: start;

            @children
        }
    }
}

// Section title of a player menu.
export component MenuHeader inherits HorizontalLayout {
    in property <string> text;

    padding-left: Theme.space-lg;
    padding-right: Theme.space-lg;
    padding-top: Theme.space-sm;
    padding-bottom: Theme.space-xs;

    LabelText {
        accessible-role: none;
        text: root.text;
        color: Theme.text-muted;
    }
}

// Thin line between two menu sections.
export component MenuDivider inherits Rectangle {
    height: Theme.border-thin;
    background: Theme.border-default;
}

// One choice of a player menu: a check when selected, the label, then muted details.
export component MenuOption inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> selected;
    callback chosen();

    accessible-role: list-item;
    accessible-label: root.detail.is-empty ? root.label : root.label + " " + root.detail;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.chosen();
    }

    preferred-width: row.preferred-width;
    height: row.preferred-height;
    background: root.selected || touch.has-hover ? Theme.bg-hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.chosen();
        }
    }

    row := HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-md;

        Rectangle {
            width: 18px;
            height: 18px;

            if root.selected: Image {
                source: Icons.check;
                width: parent.width;
                height: parent.height;
                colorize: Theme.accent;
            }
        }

        BodyText {
            accessible-role: none;
            text: root.label;
            font-weight: root.selected ? Theme.body-strong-weight : Theme.body-weight;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        if !root.detail.is-empty: detail-text := CaptionText {
            accessible-role: none;
            text: root.detail;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// An action at the end of a player menu, in the accent color: an icon and a label.
export component MenuAction inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    preferred-width: row.preferred-width;
    height: row.preferred-height;
    background: touch.has-hover ? Theme.bg-hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    row := HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        padding-top: Theme.result-padding-y;
        padding-bottom: Theme.result-padding-y;
        spacing: Theme.space-md;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 18px;
                height: 18px;
                colorize: Theme.text-secondary;
            }
        }

        LabelText {
            accessible-role: none;
            text: root.label;
            color: Theme.accent;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Small outlined square button of a delay row. It never takes the focus, so the player
// shortcuts keep working.
component StepButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    width: 28px;
    height: 28px;
    border-radius: Theme.radius-sm;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;
    background: touch.has-hover ? Theme.bg-hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: Theme.text-primary;
    }
}

// A delay of the player menu, in milliseconds: its value, a tenth of a second either way and a
// reset. Its buttons leave the focus on the player, so its shortcuts keep working.
export component DelayRow inherits HorizontalLayout {
    in property <int> delay;
    // Screen reader names of the value and of each button.
    in property <string> value-label;
    in property <string> decrease-label;
    in property <string> increase-label;
    in property <string> reset-label;
    callback step(direction: int);
    callback reset();

    padding-left: Theme.space-lg;
    padding-right: Theme.space-md;
    padding-top: Theme.space-xs;
    padding-bottom: Theme.space-xs;
    spacing: Theme.space-sm;

    BodyText {
        accessible-role: none;
        text: @tr("Delay");
        color: Theme.text-secondary;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    VerticalLayout {
        alignment: center;
        StepButton {
            icon: Icons.minus;
            label: root.decrease-label;
            clicked => {
                root.step(-1);
            }
        }
    }

    BodyStrongText {
        accessible-role: text;
        accessible-label: root.value-label;
        accessible-value: self.text;
        width: 64px;
        text: Messages.delay-text(root.delay);
        color: root.delay != 0 ? Theme.accent : Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    VerticalLayout {
        alignment: center;
        StepButton {
            icon: Icons.plus;
            label: root.increase-label;
            clicked => {
                root.step(1);
            }
        }
    }

    reset-text := LabelText {
        accessible-role: button;
        accessible-label: root.reset-label;
        accessible-enabled: root.delay != 0;
        accessible-action-default => {
            if root.delay != 0 {
                root.reset();
            }
        }
        text: @tr("Reset");
        color: root.delay != 0 ? Theme.text-secondary : Theme.text-muted;
        opacity: root.delay != 0 ? 1 : Theme.disabled-opacity;
        vertical-alignment: center;

        TouchArea {
            enabled: root.delay != 0;
            mouse-cursor: pointer;
            clicked => {
                root.reset();
            }
        }
    }
}

// Audio and subtitle menu of the player. The subtitle row with index -1 turns subtitles off.
export component TrackMenu inherits MenuPanel {
    in property <[TrackRow]> audio;
    in property <[TrackRow]> subtitles;
    // Delays in milliseconds.
    in property <int> audio-delay;
    in property <int> subtitle-delay;
    // Whether the user may search subtitles online, offered at the end of the menu.
    in property <bool> can-find-subtitles;
    callback select-audio(index: int);
    callback find-subtitles();
    callback select-subtitle(index: int);
    callback step-audio-delay(direction: int);
    callback reset-audio-delay();
    callback step-subtitle-delay(direction: int);
    callback reset-subtitle-delay();

    pure function join(first: string, second: string) -> string {
        if first.is-empty {
            return second;
        }
        if second.is-empty {
            return first;
        }
        first + " · " + second
    }

    pure function detail(row: TrackRow) -> string {
        join(join(row.detail, row.forced ? @tr("Forced") : ""), row.external ? @tr("External") : "")
    }

    accessible-role: list;
    accessible-label: @tr("Audio and subtitles");
    widest: Theme.menu-max-width;

    MenuHeader {
        text: @tr("AUDIO");
    }

    for row in root.audio: MenuOption {
        label: row.label;
        detail: root.detail(row);
        selected: row.selected;
        chosen => {
            root.select-audio(row.index);
        }
    }

    DelayRow {
        delay: root.audio-delay;
        value-label: @tr("Audio delay");
        decrease-label: @tr("Decrease the audio delay");
        increase-label: @tr("Increase the audio delay");
        reset-label: @tr("Reset the audio delay");
        step(direction) => {
            root.step-audio-delay(direction);
        }
        reset => {
            root.reset-audio-delay();
        }
    }

    MenuDivider { }

    MenuHeader {
        text: @tr("SUBTITLES");
    }

    for row in root.subtitles: MenuOption {
        label: row.index < 0 ? @tr("Off") : row.label;
        detail: root.detail(row);
        selected: row.selected;
        chosen => {
            root.select-subtitle(row.index);
        }
    }

    DelayRow {
        delay: root.subtitle-delay;
        value-label: @tr("Subtitle delay");
        decrease-label: @tr("Decrease the subtitle delay");
        increase-label: @tr("Increase the subtitle delay");
        reset-label: @tr("Reset the subtitle delay");
        step(direction) => {
            root.step-subtitle-delay(direction);
        }
        reset => {
            root.reset-subtitle-delay();
        }
    }

    if root.can-find-subtitles: MenuDivider { }

    if root.can-find-subtitles: MenuAction {
        icon: Icons.search;
        label: @tr("Find subtitles online…");
        clicked => {
            root.find-subtitles();
        }
    }
}
