import { Theme, NextUp } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Button, ButtonStyle } from "button.slint";
import { BodyStrongText, LabelText } from "text.slint";

// End of episode toast: the next episode starts when the countdown ends, unless cancelled, or
// waits for the user when they asked so.
export component NextEpisodeToast inherits Rectangle {
    in property <NextUp> next-up;
    callback play-now();
    callback cancel();

    // Part of the countdown elapsed once the current step ends, from 0 to 1: each step animates
    // to it, so the line is full when the episode starts.
    property <float> elapsed: root.next-up.total > 0 ? (root.next-up.total - root.next-up.remaining + 1) / root.next-up.total : 0;

    accessible-role: groupbox;
    accessible-label: @tr("Next episode");

    width: row.preferred-width;
    height: row.preferred-height;
    background: Theme.bg-elevated;
    border-radius: Theme.radius-lg;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;
    drop-shadow-offset-y: 8px;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.menu-shadow;

    TouchArea { }

    row := HorizontalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-lg;

        Rectangle {
            width: 160px;
            height: 90px;
            border-radius: Theme.radius-md;
            background: Theme.next-up-placeholder;
            clip: true;

            if root.next-up.has-image: Image {
                source: root.next-up.image;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
        }

        VerticalLayout {
            spacing: Theme.space-xs;
            alignment: start;

            LabelText {
                accessible-role: text;
                text: root.next-up.ask ? @tr("Up next") : @tr("Next episode in {} s", root.next-up.remaining);
                color: Theme.accent;
            }

            BodyStrongText {
                accessible-role: text;
                text: root.next-up.title;
                overflow: elide;
                max-width: 360px;
            }

            HorizontalLayout {
                padding-top: Theme.space-sm;
                spacing: Theme.space-sm;
                alignment: start;

                Button {

                    focus-on-click: false;
                    label: @tr("Play now");
                    icon: Icons.play-on-accent;
                    clicked => {
                        root.play-now();
                    }
                }

                Button {

                    focus-on-click: false;
                    label: root.next-up.ask ? @tr("Close") : @tr("Cancel");
                    style: ButtonStyle.ghost;
                    clicked => {
                        root.cancel();
                    }
                }
            }
        }
    }

    // Clipped apart from the toast, so its drop shadow stays.
    if !root.next-up.ask: Rectangle {
        accessible-role: progress-indicator;
        accessible-label: @tr("Countdown");
        accessible-value: root.next-up.remaining;
        accessible-value-minimum: 0;
        accessible-value-maximum: root.next-up.total;
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        clip: true;

        Rectangle {
            y: parent.height - self.height;
            width: 100%;
            height: Theme.countdown-height;
            background: Theme.progress-track;

            fill := Rectangle {
                x: 0;
                width: parent.width * root.elapsed;
                background: Theme.accent;
                animate width { duration: 1s; }
            }
        }
    }
}
