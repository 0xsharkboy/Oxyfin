import { Spinner } from "std-widgets.slint";
import { Theme, Message, Messages } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Button, ButtonStyle } from "button.slint";
import { Chip } from "chip.slint";
import { IconButton } from "icon_button.slint";
import { BodyStrongText, BodyText, CaptionText, HeadingText, LabelText } from "text.slint";
import { MenuPanel, MenuOption } from "track_menu.slint";

// Where the download of a subtitle result stands.
export enum SubtitleRowState { idle, downloading, added }

// A subtitle a provider of the server offers. `downloads` is -1 when unknown, `downloads-text`
// the same count in short, such as "12.4k".
export struct SubtitleResult {
    name: string,
    provider: string,
    format: string,
    downloads: int,
    downloads-text: string,
    perfect-match: bool,
    forced: bool,
    hearing-impaired: bool,
    state: SubtitleRowState,
    // The server took the download and the player waits for the file to show it.
    awaiting: bool,
}

// The subtitle search of the player, filled from Rust.
export global SubtitleSearch {
    // Whether the user may search and download subtitles on the server.
    in property <bool> allowed;
    // Identifier of the item playing; the dialog closes when it changes.
    in property <string> item;
    // ISO 639-2 code of the audio track playing, offered after the interface language.
    in property <string> audio-language;
    // ISO 639-2 codes of the language chips, and the chosen one.
    in property <[string]> languages;
    in property <string> language;
    // Every language the "Other…" list offers.
    in property <[string]> other-languages;
    in property <[SubtitleResult]> results;
    in property <bool> searching;
    in property <bool> has-error;
    in property <Message> error;
    callback opened();
    callback language-chosen(code: string);
    callback download(index: int);

    // The name of a language given by its ISO 639-2 bibliographic code, or the code itself.
    public pure function language-name(code: string) -> string {
        if code == "eng" { return @tr("English"); }
        if code == "fre" { return @tr("French"); }
        if code == "spa" { return @tr("Spanish"); }
        if code == "ger" { return @tr("German"); }
        if code == "ita" { return @tr("Italian"); }
        if code == "por" { return @tr("Portuguese"); }
        if code == "dut" { return @tr("Dutch"); }
        if code == "swe" { return @tr("Swedish"); }
        if code == "nor" { return @tr("Norwegian"); }
        if code == "dan" { return @tr("Danish"); }
        if code == "fin" { return @tr("Finnish"); }
        if code == "ice" { return @tr("Icelandic"); }
        if code == "pol" { return @tr("Polish"); }
        if code == "cze" { return @tr("Czech"); }
        if code == "slo" { return @tr("Slovak"); }
        if code == "hun" { return @tr("Hungarian"); }
        if code == "rum" { return @tr("Romanian"); }
        if code == "bul" { return @tr("Bulgarian"); }
        if code == "gre" { return @tr("Greek"); }
        if code == "rus" { return @tr("Russian"); }
        if code == "ukr" { return @tr("Ukrainian"); }
        if code == "hrv" { return @tr("Croatian"); }
        if code == "srp" { return @tr("Serbian"); }
        if code == "slv" { return @tr("Slovenian"); }
        if code == "est" { return @tr("Estonian"); }
        if code == "lav" { return @tr("Latvian"); }
        if code == "lit" { return @tr("Lithuanian"); }
        if code == "tur" { return @tr("Turkish"); }
        if code == "ara" { return @tr("Arabic"); }
        if code == "heb" { return @tr("Hebrew"); }
        if code == "per" { return @tr("Persian"); }
        if code == "hin" { return @tr("Hindi"); }
        if code == "tha" { return @tr("Thai"); }
        if code == "vie" { return @tr("Vietnamese"); }
        if code == "ind" { return @tr("Indonesian"); }
        if code == "may" { return @tr("Malay"); }
        if code == "chi" { return @tr("Chinese"); }
        if code == "jpn" { return @tr("Japanese"); }
        if code == "kor" { return @tr("Korean"); }
        if code == "cat" { return @tr("Catalan"); }
        code
    }
}

// Small outlined tag of a result, such as "Forced".
component Tag inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text-secondary;
    in property <color> border: Theme.border-default;

    border-radius: Theme.radius-xs;
    border-width: Theme.border-thin;
    border-color: root.border;

    HorizontalLayout {
        padding-left: Theme.tag-padding-x;
        padding-right: Theme.tag-padding-x;
        padding-top: Theme.tag-padding-y;
        padding-bottom: Theme.tag-padding-y;

        CaptionText {
            text: root.text;
            color: root.text-color;
        }
    }
}

component ResultRow inherits Rectangle {
    in property <SubtitleResult> result;
    callback download();

    pure function join(first: string, second: string) -> string {
        if first.is-empty {
            return second;
        }
        if second.is-empty {
            return first;
        }
        first + " · " + second
    }

    property <string> downloads: root.result.downloads < 0 ? "" : root.result.downloads == 1 ? @tr("1 download") : @tr("{} downloads", root.result.downloads-text);

    accessible-role: list-item;
    accessible-label: root.result.name;

    background: touch.has-hover ? Theme.bg-hover : transparent;

    touch := TouchArea { }

    HorizontalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-lg;
        padding-top: Theme.result-padding-y;
        padding-bottom: Theme.result-padding-y;
        spacing: Theme.space-md;

        VerticalLayout {
            alignment: center;
            spacing: Theme.space-xs;
            horizontal-stretch: 1;

            BodyStrongText {
                text: root.result.name;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-sm;

                CaptionText {
                    text: root.join(root.join(root.result.provider, root.result.format), root.downloads);
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.result.perfect-match: Tag {
                    text: @tr("Perfect match");
                    text-color: Theme.watched;
                    border: Theme.watched;
                }
                if root.result.forced: Tag {
                    text: @tr("Forced");
                }
                if root.result.hearing-impaired: Tag {
                    text: @tr("Hearing impaired");
                }
            }
        }

        if root.result.state == SubtitleRowState.idle: VerticalLayout {
            alignment: center;
            Button {
                style: ButtonStyle.secondary;
                label: @tr("Download");
                clicked => {
                    root.download();
                }
            }
        }

        if root.result.state == SubtitleRowState.downloading: LabelText {
            accessible-role: text;
            text: @tr("Downloading…");
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        if root.result.state == SubtitleRowState.added: HorizontalLayout {
            spacing: Theme.space-md;

            VerticalLayout {
                alignment: center;
                Image {
                    source: Icons.check;
                    width: Theme.result-icon-size;
                    height: Theme.result-icon-size;
                    colorize: Theme.watched;
                }
            }
            LabelText {
                text: @tr("Added");
                color: Theme.watched;
                vertical-alignment: center;
            }
        }
    }
}

// Dialog of the player that finds subtitles online through the server and downloads them.
export component SubtitleSearchDialog inherits Rectangle {
    // What plays, such as "Les Veilleurs · S02E05 · The Pact".
    in property <string> item;
    // Height the dialog may take at most.
    in property <length> limit: 600px;
    callback close();

    property <bool> other-open;

    accessible-role: groupbox;
    accessible-label: @tr("Find subtitles");

    width: Theme.dialog-width;
    height: min(content.preferred-height, root.limit);
    background: Theme.bg-elevated;
    border-radius: Theme.radius-xl;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;
    drop-shadow-offset-y: Theme.dialog-shadow-offset-y;
    drop-shadow-blur: Theme.dialog-shadow-blur;
    drop-shadow-color: Theme.menu-shadow;
    clip: true;

    // Clicks inside the dialog never reach the player behind it.
    TouchArea {
        clicked => {
            root.other-open = false;
        }
        double-clicked => { }
    }

    content := VerticalLayout {
        padding-top: Theme.space-xl;
        padding-bottom: Theme.space-lg;
        spacing: Theme.space-lg;

        HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-lg;
            spacing: Theme.space-sm;

            VerticalLayout {
                spacing: Theme.space-2xs;
                horizontal-stretch: 1;
                alignment: center;

                HeadingText {
                    text: @tr("Find subtitles");
                    overflow: elide;
                }
                CaptionText {
                    text: root.item;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    focus-on-click: false;
                    icon: Icons.x;
                    label: @tr("Close");
                    clicked => {
                        root.close();
                    }
                }
            }
        }

        language-row := HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;
            spacing: Theme.space-sm;
            alignment: start;

            LabelText {
                text: @tr("Language");
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            for code in SubtitleSearch.languages: Chip {
                label: SubtitleSearch.language-name(code);
                selected: code == SubtitleSearch.language;
                clicked => {
                    root.other-open = false;
                    SubtitleSearch.language-chosen(code);
                }
            }

            other-chip := Chip {
                label: @tr("Other…");
                selected: root.other-open;
                clicked => {
                    root.other-open = !root.other-open;
                }
            }
        }

        if SubtitleSearch.searching: HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;
            spacing: Theme.space-sm;
            alignment: start;

            Spinner {
                indeterminate: true;
                width: Theme.result-icon-size;
                height: Theme.result-icon-size;
            }
            LabelText {
                text: @tr("Searching…");
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
        }

        if SubtitleSearch.has-error: HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;

            BodyText {
                accessible-role: text;
                text: Messages.message-text(SubtitleSearch.error, "");
                color: Theme.danger;
                wrap: word-wrap;
            }
        }

        if !SubtitleSearch.searching && !SubtitleSearch.has-error && SubtitleSearch.results.length == 0: HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;

            BodyText {
                accessible-role: text;
                text: @tr("No subtitles found in this language.");
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }

        if SubtitleSearch.results.length > 0: Flickable {
            accessible-role: list;
            accessible-label: @tr("Subtitles found");
            vertical-stretch: 1;
            min-height: min(rows.preferred-height, 2 * Theme.space-3xl);
            preferred-height: rows.preferred-height;
            content-height: rows.preferred-height;

            rows := VerticalLayout {
                width: parent.width;
                alignment: start;

                for result[index] in SubtitleSearch.results: ResultRow {
                    result: result;
                    download => {
                        SubtitleSearch.download(index);
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;

            CaptionText {
                text: @tr("Subtitles come from your server's subtitle providers and are saved next to the video.");
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }

    if root.other-open: MenuPanel {
        x: language-row.x + other-chip.x;
        y: language-row.y + language-row.height + Theme.space-xs;
        limit: max(Theme.space-3xl, root.height - self.y - Theme.space-lg);
        accessible-role: list;
        accessible-label: @tr("Other languages");

        for code in SubtitleSearch.other-languages: MenuOption {
            label: SubtitleSearch.language-name(code);
            selected: code == SubtitleSearch.language;
            chosen => {
                root.other-open = false;
                SubtitleSearch.language-chosen(code);
            }
        }
    }
}
