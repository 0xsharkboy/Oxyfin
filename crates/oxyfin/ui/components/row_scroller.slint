import { HoverCard } from "hover_card.slint";
import { MouseBack } from "mouse_back.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

// Round button of a row edge; it never takes the keyboard focus, Left and Right do its job.
component RowArrow inherits Rectangle {
    in property <bool> forward;
    callback clicked();

    accessible-role: button;
    accessible-label: root.forward ? @tr("Scroll right") : @tr("Scroll left");
    accessible-action-default => {
        root.clicked();
    }

    width: Theme.row-arrow-size;
    height: self.width;
    border-radius: Theme.radius-full;
    background: touch.has-hover ? Theme.bg-hover : Theme.bg-elevated;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            MouseBack.handle(event);
        }
        clicked => {
            root.clicked();
        }
    }

    Image {
        width: 24px;
        height: 24px;
        source: root.forward ? Icons.chevron-right : Icons.chevron-left;
    }
}

// Sideways scrolling of a row of cards: edge arrows on hover, the wheel, and Left and Right
// to move the focus between the cards placed inside.
export component RowScroller inherits Rectangle {
    // Number of cards, and the one to focus next; each card binds `focus-wanted` to it.
    in property <int> count;
    out property <int> wanted: -1;
    in property <length> spacing;
    in property <length> padding-x: Theme.space-3xl;
    // Height from the top of the row that the arrows are centred on.
    in property <length> arrows-over: root.height;

    property <int> current: -1;
    // Which way the keyboard last moved the focus.
    property <int> direction: 1;
    property <length> min-x: min(0px, flick.width - flick.content-width);
    property <bool> can-back: flick.content-x < -0.5px;
    property <bool> can-forward: flick.content-x > root.min-x + 0.5px;

    // Where the last animated scroll goes and when it started: reading `content-x` gives the
    // animated value, so a click during the animation pages on from where the row is going.
    property <length> target-x;
    property <duration> target-tick: -3600s;
    property <length> card-width: root.count > 0 ? (cards.preferred-width - 2 * root.padding-x - (root.count - 1) * root.spacing) / root.count : 0px;

    // Called by the card at `index` when it takes the keyboard focus; the card is scrolled clear
    // of the faded edges.
    public function card-focused(index: int) {
        root.current = index;
        root.wanted = -1;
        root.reveals += 1;
    }

    // Called by the card at `index` when it was asked to take the focus but cannot: the next one
    // the same way is asked instead.
    public function passed-over(index: int) {
        let next = index + root.direction;
        root.wanted = next >= 0 && next < root.count ? next : -1;
    }

    // Grows at every focused card; handled once the focus has scrolled the card into view.
    property <int> reveals;
    changed reveals => {
        let left = root.padding-x + root.current * (root.card-width + root.spacing);
        let x = root.heading-x();
        if left + x < Theme.row-arrow-zone {
            root.scroll-to(Theme.row-arrow-zone - left);
        } else if left + root.card-width + x > flick.width - Theme.row-arrow-zone {
            root.scroll-to(flick.width - Theme.row-arrow-zone - left - root.card-width);
        }
    }

    function heading-x() -> length {
        animation-tick() - root.target-tick < Theme.row-scroll-duration ? root.target-x : flick.content-x
    }

    function scroll-to(x: length) {
        root.target-x = clamp(x, root.min-x, 0px);
        root.target-tick = animation-tick();
        flick.content-x = root.target-x;
    }

    function page(direction: int) {
        root.scroll-to(root.heading-x() - direction * (flick.width - Theme.row-arrow-zone));
    }

    height: cards.preferred-height;

    hover := TouchArea {
        pointer-event(event) => {
            MouseBack.handle(event);
        }
        keys := FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift {
                    return reject;
                }
                if event.text == Key.RightArrow && root.current >= 0 && root.current < root.count - 1 {
                    root.direction = 1;
                    root.wanted = root.current + 1;
                    return accept;
                }
                if event.text == Key.LeftArrow && root.current > 0 && root.current < root.count {
                    root.direction = -1;
                    root.wanted = root.current - 1;
                    return accept;
                }
                reject
            }

            flick := Flickable {
                mouse-drag-pan-enabled: false;
                content-width: cards.preferred-width;
                content-height: self.height;
                changed viewport-x => {
                    HoverCard.scrolled();
                }
                animate content-x {
                    duration: Theme.row-scroll-duration;
                    easing: ease-out;
                }

                cards := HorizontalLayout {
                    padding-left: root.padding-x;
                    padding-right: root.padding-x;
                    spacing: root.spacing;
                    alignment: start;

                    @children
                }
            }

            if hover.has-hover && root.can-back: Rectangle {
                x: 0;
                width: Theme.row-arrow-zone;
                background: Theme.row-scrim-left;

                RowArrow {
                    x: Theme.space-lg;
                    y: (root.arrows-over - self.height) / 2;
                    forward: false;
                    clicked => {
                        root.page(-1);
                    }
                }
            }

            if hover.has-hover && root.can-forward: Rectangle {
                x: parent.width - self.width;
                width: Theme.row-arrow-zone;
                background: Theme.row-scrim-right;

                RowArrow {
                    x: parent.width - self.width - Theme.space-lg;
                    y: (root.arrows-over - self.height) / 2;
                    forward: true;
                    clicked => {
                        root.page(1);
                    }
                }
            }
        }
    }
}
