import { Theme, CardData } from "../theme.slint";
import { CardStatus } from "card.slint";
import { PosterCard } from "poster_card.slint";
import { HeadingText } from "text.slint";

// A titled row of posters that scrolls sideways to the right edge of the window.
export component PosterRow inherits Rectangle {
    in property <string> title;
    in property <[CardData]> items;
    in property <length> title-spacing: Theme.space-lg;
    in property <length> card-spacing: Theme.space-xl;
    callback clicked(id: string);

    accessible-role: list;
    accessible-label: root.title;

    pure function status(card: CardData) -> CardStatus {
        if card.watched {
            return CardStatus.watched;
        }
        card.progress > 0 ? CardStatus.in-progress : CardStatus.default
    }

    VerticalLayout {
        padding-left: Theme.space-3xl;
        spacing: root.title-spacing;

        HeadingText {
            text: root.title;
            overflow: elide;
        }

        Flickable {
            height: cards.preferred-height;
            content-width: cards.preferred-width;
            content-height: self.height;

            cards := HorizontalLayout {
                padding-right: Theme.space-3xl;
                spacing: root.card-spacing;

                for card in root.items: PosterCard {
                    title: card.title;
                    subtitle: card.subtitle;
                    image: card.image;
                    status: root.status(card);
                    progress: card.progress;
                    clicked => {
                        root.clicked(card.id);
                    }
                }
            }
        }
    }
}
