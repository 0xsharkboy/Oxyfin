import { Theme, CardData } from "../theme.slint";
import { Banner } from "../components/banner.slint";
import { TopBar, TopBarPage } from "../components/top_bar.slint";
import { CardStatus } from "../components/card.slint";
import { LandscapeCard } from "../components/landscape_card.slint";
import { PosterRow } from "../components/poster_row.slint";
import { BodyText, HeadingText } from "../components/text.slint";

export enum HomeRowKind { landscape, poster }

// Featured item of the home screen; `has` is false until it is known.
export struct HomeBanner {
    has: bool,
    // False when the item has no detail page to open.
    has-detail: bool,
    title: string,
    year: int,
    duration-minutes: int,
    card: CardData,
}

// A row of the home screen; `error` is set instead of `items` when it failed to load.
export struct HomeRow {
    title: string,
    kind: HomeRowKind,
    items: [CardData],
    error: string,
}

// Titles of the home rows, translated here because Rust builds the rows.
export global HomeTitles {
    public pure function continue-watching() -> string {
        @tr("Continue Watching")
    }
    public pure function next-up() -> string {
        @tr("Next Up")
    }
    public pure function recently-added(library: string) -> string {
        @tr("Recently Added in {}", library)
    }
}

component HomeRowView inherits Rectangle {
    in property <HomeRow> section;
    callback play(id: string);
    callback open(id: string);

    property <bool> posters: root.section.error == "" && root.section.kind == HomeRowKind.poster;

    pure function status(card: CardData) -> CardStatus {
        if card.watched {
            return CardStatus.watched;
        }
        card.progress > 0 ? CardStatus.in-progress : CardStatus.default
    }

    VerticalLayout {
        if root.posters: PosterRow {
            title: root.section.title;
            items: root.section.items;
            title-spacing: Theme.space-md;
            card-spacing: Theme.space-lg;
            clicked(id) => {
                root.open(id);
            }
        }

        if !root.posters: Rectangle {
            accessible-role: list;
            accessible-label: root.section.title;

            VerticalLayout {
                padding-left: Theme.space-3xl;
                spacing: Theme.space-md;

                HeadingText {
                    text: root.section.title;
                    overflow: elide;
                }

                if root.section.error != "": BodyText {
                    text: root.section.error;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                if root.section.error == "": Flickable {
                    height: landscape-cards.preferred-height;
                    content-width: landscape-cards.preferred-width;
                    content-height: self.height;

                    landscape-cards := HorizontalLayout {
                        padding-right: Theme.space-3xl;
                        spacing: Theme.space-lg;

                        for card in root.section.items: LandscapeCard {
                            title: card.title;
                            subtitle: card.subtitle;
                            image: card.image;
                            status: root.status(card);
                            progress: card.progress;
                            clicked => {
                                root.play(card.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

// Home: top bar, featured banner, then one horizontal row per section.
export component HomeScreen inherits Rectangle {
    in property <HomeBanner> banner;
    in property <[HomeRow]> rows;
    // True once every source of the screen has answered.
    in property <bool> settled;
    callback open-tab(page: TopBarPage);
    callback play(id: string);
    callback open-item(id: string);
    callback open-settings();

    accessible-role: groupbox;
    accessible-label: @tr("Home");

    background: Theme.bg-base;

    pure function banner-meta(year: int, minutes: int) -> string {
        if minutes <= 0 {
            return year > 0 ? "\{year}" : "";
        }
        let duration = minutes >= 60 ? @tr("{}h {}m", floor(minutes / 60), mod(minutes, 60)) : @tr("{}m", minutes);
        year > 0 ? "\{year} \u{b7} \{duration}" : duration
    }

    flick := Flickable {
        content-width: self.width;
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: parent.width;
            alignment: start;
            padding-bottom: Theme.space-3xl;
            spacing: Theme.space-2xl;

            if root.banner.has: Banner {
                height: self.preferred-height;
                backdrop: root.banner.card.image;
                title: root.banner.title;
                has-detail: root.banner.has-detail;
                meta: root.banner-meta(root.banner.year, root.banner.duration-minutes);
                play => {
                    root.play(root.banner.card.id);
                }
                more-info => {
                    root.open-item(root.banner.card.id);
                }
            }
            if !root.banner.has: Rectangle {
                height: top-bar.height;
            }

            for row in root.rows: HomeRowView {
                section: row;
                play(id) => {
                    root.play(id);
                }
                open(id) => {
                    root.open-item(id);
                }
            }

            if root.settled && !root.banner.has && root.rows.length == 0: VerticalLayout {
                alignment: center;
                padding: Theme.space-3xl;
                spacing: Theme.space-sm;

                HeadingText {
                    text: @tr("Nothing to show yet");
                    horizontal-alignment: center;
                }

                BodyText {
                    text: @tr("Movies and shows you add or start watching will appear here.");
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }
        }
    }

    top-bar := TopBar {
        scrolled-by: -flick.content-y;
        y: 0;
        height: self.preferred-height;
        current: TopBarPage.home;
        movies-clicked => {
            root.open-tab(TopBarPage.movies);
        }
        search-clicked => {
            root.open-tab(TopBarPage.search);
        }
        shows-clicked => {
            root.open-tab(TopBarPage.shows);
        }
        favorites-clicked => {
            root.open-tab(TopBarPage.favorites);
        }
        settings-clicked => {
            root.open-settings();
        }
    }
}
