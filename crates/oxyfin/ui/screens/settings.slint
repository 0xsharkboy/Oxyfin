import { Theme } from "../theme.slint";
import { Button, ButtonStyle } from "../components/button.slint";
import { TopBar, TopBarPage } from "../components/top_bar.slint";
import { BodyText, DisplayText, HeadingText, LabelText } from "../components/text.slint";
import { Chip } from "../components/chip.slint";

// How subtitles look, as indexes into the choices of each row (see `oxyfin_core::SubtitleStyle`).
export struct SubtitleChoice {
    size: int,
    color: int,
    background: int,
    position: int,
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: Theme.space-lg;

    LabelText {
        width: 160px;
        text: root.label;
        vertical-alignment: center;
    }
    BodyText {
        horizontal-stretch: 1;
        text: root.value;
        overflow: elide;
        vertical-alignment: center;
    }
}

// A setting picked among a few chips.
component ChoiceRow inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <int> selected;
    callback chosen(index: int);

    spacing: Theme.space-lg;

    LabelText {
        width: 160px;
        text: root.label;
        vertical-alignment: center;
    }
    HorizontalLayout {
        horizontal-stretch: 1;
        alignment: start;
        spacing: Theme.space-sm;

        for option[index] in root.options: Chip {
            label: option;
            selected: index == root.selected;
            clicked => {
                root.chosen(index);
            }
        }
    }
}

// A frame of video with a subtitle line drawn as the player would.
component SubtitlePreview inherits Rectangle {
    in property <SubtitleChoice> choice;

    // Scales of `oxyfin_core::SubtitleSize`, smallest first.
    property <[float]> scales: [0.8, 1, 1.25, 1.5];
    property <bool> boxed: root.choice.background == 1;
    // mpv keeps the bottom of the text this far above the bottom of the video.
    property <length> margin: root.height * 0.06;
    property <length> bottom: root.choice.position == 1 ? root.height * 0.9 - root.margin : root.height - root.margin;

    height: 128px;
    border-radius: Theme.radius-md;
    clip: true;
    background: Theme.hero-placeholder;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.bottom - self.height;
        width: min(line.preferred-width + 2 * Theme.space-xs, parent.width);
        height: line.preferred-height;
        background: root.boxed ? Theme.subtitle-box : transparent;

        line := Text {
            width: parent.width - 2 * Theme.space-xs;
            x: Theme.space-xs;
            text: @tr("The quick brown fox jumps over the lazy dog");
            font-size: 18px * root.scales[root.choice.size];
            font-weight: 500;
            color: root.choice.color == 1 ? Theme.subtitle-yellow : Theme.subtitle-white;
            stroke: root.boxed ? transparent : Theme.subtitle-outline;
            stroke-width: root.boxed ? 0 : 1.5px;
            stroke-style: outside;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

component SettingSection inherits Rectangle {
    in property <string> title;

    background: Theme.bg-elevated;
    border-radius: Theme.radius-lg;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;

    VerticalLayout {
        alignment: start;
        padding: Theme.space-xl;
        spacing: Theme.space-md;

        HeadingText {
            text: root.title;
        }
        @children
    }
}

// Settings: the signed-in account, the subtitle style, the application version and the sign-out action.
export component SettingsScreen inherits Rectangle {
    in property <string> server-name;
    in property <string> server-address;
    in property <string> user-name;
    in property <bool> token-in-file;
    in property <string> version;
    in property <TopBarPage> page: TopBarPage.none;
    in property <SubtitleChoice> subtitles;
    callback open-tab(page: TopBarPage);
    callback back();
    callback sign-out();
    callback subtitles-changed(choice: SubtitleChoice);

    accessible-role: groupbox;
    accessible-label: @tr("Settings");

    background: Theme.bg-base;
    forward-focus: keys;

    // Wraps the content so Escape reaches it from any focused control.
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.back();
                return accept;
            }
            reject
        }

        flick := Flickable {
            y: top-bar.height;
            height: parent.height - self.y;
            content-width: self.width;
            content-height: max(content.preferred-height, self.height);

            // The mouse back button, on whatever lies behind the content.
            TouchArea {
                width: flick.content-width;
                height: flick.content-height;
                pointer-event(event) => {
                    if event.button == PointerEventButton.back && event.kind == PointerEventKind.up {
                        root.back();
                    }
                }
            }

            content := HorizontalLayout {
                width: parent.width;
                alignment: center;

                VerticalLayout {
                    width: min(640px, root.width - 2 * Theme.space-3xl);
                    alignment: start;
                    padding-top: Theme.space-xl;
                    padding-bottom: Theme.space-3xl;
                    spacing: Theme.space-xl;

                    DisplayText {
                        text: @tr("Settings");
                    }

                    SettingSection {
                        title: @tr("Account");

                        SettingRow {
                            label: @tr("Server");
                            value: root.server-name != "" ? @tr("{} ({})", root.server-name, root.server-address) : root.server-address;
                        }
                        SettingRow {
                            label: @tr("Signed in as");
                            value: root.user-name;
                        }
                        SettingRow {
                            label: @tr("Sign-in token");
                            value: root.token-in-file ? @tr("Stored in a private file") : @tr("Stored in the system keyring");
                        }
                        HorizontalLayout {
                            padding-top: Theme.space-sm;
                            alignment: start;

                            Button {
                                label: @tr("Sign out");
                                style: ButtonStyle.secondary;
                                clicked => {
                                    root.sign-out();
                                }
                            }
                        }
                    }

                    SettingSection {
                        title: @tr("Subtitles");

                        SubtitlePreview {
                            choice: root.subtitles;
                        }
                        ChoiceRow {
                            label: @tr("Size");
                            options: [@tr("Small"), @tr("Normal"), @tr("Large"), @tr("Extra large")];
                            selected: root.subtitles.size;
                            chosen(index) => {
                                root.subtitles-changed({
                                    size: index,
                                    color: root.subtitles.color,
                                    background: root.subtitles.background,
                                    position: root.subtitles.position,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Color");
                            options: [@tr("White"), @tr("Yellow")];
                            selected: root.subtitles.color;
                            chosen(index) => {
                                root.subtitles-changed({
                                    size: root.subtitles.size,
                                    color: index,
                                    background: root.subtitles.background,
                                    position: root.subtitles.position,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Background");
                            options: [@tr("Outline"), @tr("Box")];
                            selected: root.subtitles.background;
                            chosen(index) => {
                                root.subtitles-changed({
                                    size: root.subtitles.size,
                                    color: root.subtitles.color,
                                    background: index,
                                    position: root.subtitles.position,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Position");
                            options: [@tr("Bottom"), @tr("Raised")];
                            selected: root.subtitles.position;
                            chosen(index) => {
                                root.subtitles-changed({
                                    size: root.subtitles.size,
                                    color: root.subtitles.color,
                                    background: root.subtitles.background,
                                    position: index,
                                });
                            }
                        }
                    }

                    SettingSection {
                        title: @tr("About");

                        SettingRow {
                            label: @tr("Version");
                            // Brand name, not translated.
                            value: "Oxyfin \{root.version}";
                        }
                    }
                }
            }
        }

        top-bar := TopBar {
            y: 0;
            height: self.preferred-height;
            current: root.page;
            settings-active: true;
            home-clicked => {
                root.open-tab(TopBarPage.home);
            }
            movies-clicked => {
                root.open-tab(TopBarPage.movies);
            }
            shows-clicked => {
                root.open-tab(TopBarPage.shows);
            }
            favorites-clicked => {
                root.open-tab(TopBarPage.favorites);
            }
            search-clicked => {
                root.open-tab(TopBarPage.search);
            }
            settings-clicked => {
                root.back();
            }
        }
    }

    init => {
        keys.focus();
    }
}
