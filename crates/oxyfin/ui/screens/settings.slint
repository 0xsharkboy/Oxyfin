import { Theme } from "../theme.slint";
import { Button, ButtonStyle } from "../components/button.slint";
import { TopBar, TopBarPage } from "../components/top_bar.slint";
import { BodyText, CaptionText, DisplayText, HeadingText, LabelText } from "../components/text.slint";
import { Chip } from "../components/chip.slint";
import { TextField } from "../components/text_field.slint";

// Where the sign-in token is kept; mirrors the core `TokenStorage`.
export enum TokenStore { keyring, file, memory }

// Progress of a Quick Connect code typed to sign another device in.
export enum AuthorizeState { idle, busy, done, wrong-code, unavailable, failed }

// How subtitles look, as indexes into the choices of each row (see `oxyfin_core::SubtitleStyle`).
export struct SubtitleChoice {
    size: int,
    color: int,
    background: int,
    position: int,
}

// Playback choices, as indexes into the choices of each row (see `oxyfin_core::PlaybackPrefs`).
export struct PlaybackChoice {
    autoplay: int,
    countdown: int,
    intros: int,
    recaps: int,
    tracks: int,
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: Theme.space-lg;

    LabelText {
        width: 160px;
        text: root.label;
        vertical-alignment: center;
    }
    BodyText {
        horizontal-stretch: 1;
        text: root.value;
        overflow: elide;
        vertical-alignment: center;
    }
}

// A setting picked among a few chips, with an optional caption under its label.
component ChoiceRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> caption;
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    callback chosen(index: int);

    spacing: Theme.space-lg;

    VerticalLayout {
        width: 160px;
        alignment: center;
        spacing: Theme.space-2xs;

        LabelText {
            text: root.label;
            wrap: word-wrap;
        }
        if !root.caption.is-empty: CaptionText {
            text: root.caption;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        horizontal-stretch: 1;
        alignment: start;
        spacing: Theme.space-sm;

        for option[index] in root.options: VerticalLayout {
            alignment: center;

            Chip {
                label: option;
                selected: index == root.selected;
                enabled: root.enabled;
                clicked => {
                    root.chosen(index);
                }
            }
        }
    }
}

// A frame of video with a subtitle line drawn as the player would.
component SubtitlePreview inherits Rectangle {
    in property <SubtitleChoice> choice;

    // Scales of `oxyfin_core::SubtitleSize`, smallest first.
    property <[float]> scales: [0.8, 1, 1.25, 1.5];
    property <bool> boxed: root.choice.background == 1;
    // mpv keeps the bottom of the text this far above the bottom of the video.
    property <length> margin: root.height * 0.06;
    property <length> bottom: root.choice.position == 1 ? root.height * 0.9 - root.margin : root.height - root.margin;

    height: 128px;
    border-radius: Theme.radius-md;
    clip: true;
    background: Theme.hero-placeholder;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.bottom - self.height;
        width: min(line.preferred-width + 2 * Theme.space-xs, parent.width);
        height: line.preferred-height;
        background: root.boxed ? Theme.subtitle-box : transparent;

        line := Text {
            width: parent.width - 2 * Theme.space-xs;
            x: Theme.space-xs;
            text: @tr("The quick brown fox jumps over the lazy dog");
            font-size: 18px * root.scales[root.choice.size];
            font-weight: 500;
            color: root.choice.color == 1 ? Theme.subtitle-yellow : Theme.subtitle-white;
            stroke: root.boxed ? transparent : Theme.subtitle-outline;
            stroke-width: root.boxed ? 0 : 1.5px;
            stroke-style: outside;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

component SettingSection inherits Rectangle {
    in property <string> title;

    background: Theme.bg-elevated;
    border-radius: Theme.radius-lg;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;

    VerticalLayout {
        alignment: start;
        padding: Theme.space-xl;
        spacing: Theme.space-md;

        HeadingText {
            text: root.title;
        }
        @children
    }
}

// Settings: the signed-in account, playback, the subtitle style, the Quick Connect code entry, the
// application version and the sign-out action.
export component SettingsScreen inherits Rectangle {
    in property <string> server-name;
    in property <string> server-address;
    in property <string> user-name;
    in property <TokenStore> token-store;
    in property <string> version;
    in property <SubtitleChoice> subtitles;
    callback open-tab(page: TopBarPage);
    callback back();
    callback sign-out();
    // Whether the window opens fullscreen, from the next launch on.
    in property <bool> start-fullscreen;
    callback subtitles-changed(choice: SubtitleChoice);
    callback start-fullscreen-changed(on: bool);
    in property <PlaybackChoice> playback;
    callback playback-changed(choice: PlaybackChoice);
    // The Quick Connect code typed to sign another device in.
    in-out property <string> authorize-code;
    in-out property <AuthorizeState> authorize-state;
    // Whether `code` holds more than spaces.
    pure callback code-ready(code: string) -> bool;
    callback authorize(code: string);

    property <bool> can-authorize: root.authorize-state != AuthorizeState.busy && root.code-ready(root.authorize-code);

    function submit-code() {
        if root.can-authorize {
            root.authorize(root.authorize-code);
        }
    }

    accessible-role: groupbox;
    accessible-label: @tr("Settings");

    background: Theme.bg-base;
    forward-focus: keys;

    // Wraps the content so Escape reaches it from any focused control.
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.back();
                return accept;
            }
            reject
        }

        flick := Flickable {
            y: top-bar.height;
            height: parent.height - self.y;
            content-width: self.width;
            content-height: max(content.preferred-height, self.height);

            // The mouse back button, on whatever lies behind the content.
            TouchArea {
                width: flick.content-width;
                height: flick.content-height;
                pointer-event(event) => {
                    if event.button == PointerEventButton.back && event.kind == PointerEventKind.up {
                        root.back();
                    }
                }
            }

            content := HorizontalLayout {
                width: parent.width;
                alignment: center;

                VerticalLayout {
                    width: min(640px, root.width - 2 * Theme.space-3xl);
                    alignment: start;
                    padding-top: Theme.space-xl;
                    padding-bottom: Theme.space-3xl;
                    spacing: Theme.space-xl;

                    DisplayText {
                        text: @tr("Settings");
                    }

                    SettingSection {
                        title: @tr("Account");

                        SettingRow {
                            label: @tr("Server");
                            value: root.server-name != "" ? @tr("{} ({})", root.server-name, root.server-address) : root.server-address;
                        }
                        SettingRow {
                            label: @tr("Signed in as");
                            value: root.user-name;
                        }
                        SettingRow {
                            label: @tr("Sign-in token");
                            value: root.token-store == TokenStore.file ? @tr("Stored in a private file")
                                : root.token-store == TokenStore.memory ? @tr("Kept in memory for this session")
                                : @tr("Stored in the system keyring");
                        }
                        HorizontalLayout {
                            padding-top: Theme.space-sm;
                            alignment: start;

                            Button {
                                label: @tr("Sign out");
                                style: ButtonStyle.secondary;
                                clicked => {
                                    root.sign-out();
                                }
                            }
                        }
                    }

                    SettingSection {
                        title: @tr("Playback");

                        ChoiceRow {
                            label: @tr("Start in fullscreen");
                            caption: @tr("Also with --fullscreen");
                            options: [@tr("Off"), @tr("On")];
                            selected: root.start-fullscreen ? 1 : 0;
                            chosen(index) => {
                                root.start-fullscreen-changed(index == 1);
                            }
                        }
                        ChoiceRow {
                            label: @tr("Play the next episode");
                            options: [@tr("Ask"), @tr("Automatically")];
                            selected: root.playback.autoplay;
                            chosen(index) => {
                                root.playback-changed({
                                    autoplay: index,
                                    countdown: root.playback.countdown,
                                    intros: root.playback.intros,
                                    recaps: root.playback.recaps,
                                    tracks: root.playback.tracks,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Countdown");
                            caption: @tr("Before the next episode starts");
                            options: [@tr("{} s", 5), @tr("{} s", 10), @tr("{} s", 15), @tr("{} s", 30)];
                            selected: root.playback.countdown;
                            enabled: root.playback.autoplay == 1;
                            chosen(index) => {
                                root.playback-changed({
                                    autoplay: root.playback.autoplay,
                                    countdown: index,
                                    intros: root.playback.intros,
                                    recaps: root.playback.recaps,
                                    tracks: root.playback.tracks,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Intros");
                            options: [@tr("Show a skip button"), @tr("Skip automatically")];
                            selected: root.playback.intros;
                            chosen(index) => {
                                root.playback-changed({
                                    autoplay: root.playback.autoplay,
                                    countdown: root.playback.countdown,
                                    intros: index,
                                    recaps: root.playback.recaps,
                                    tracks: root.playback.tracks,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Recaps and previews");
                            options: [@tr("Show a skip button"), @tr("Skip automatically")];
                            selected: root.playback.recaps;
                            chosen(index) => {
                                root.playback-changed({
                                    autoplay: root.playback.autoplay,
                                    countdown: root.playback.countdown,
                                    intros: root.playback.intros,
                                    recaps: index,
                                    tracks: root.playback.tracks,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Audio and subtitles");
                            caption: @tr("Keeps the language you pick for the rest of the series");
                            options: [@tr("Server defaults"), @tr("Remember per series")];
                            selected: root.playback.tracks;
                            chosen(index) => {
                                root.playback-changed({
                                    autoplay: root.playback.autoplay,
                                    countdown: root.playback.countdown,
                                    intros: root.playback.intros,
                                    recaps: root.playback.recaps,
                                    tracks: index,
                                });
                            }
                        }
                    }

                    SettingSection {
                        title: @tr("Subtitles");

                        SubtitlePreview {
                            choice: root.subtitles;
                        }
                        ChoiceRow {
                            label: @tr("Size");
                            options: [@tr("Small"), @tr("Normal"), @tr("Large"), @tr("Extra large")];
                            selected: root.subtitles.size;
                            chosen(index) => {
                                root.subtitles-changed({
                                    size: index,
                                    color: root.subtitles.color,
                                    background: root.subtitles.background,
                                    position: root.subtitles.position,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Color");
                            options: [@tr("White"), @tr("Yellow")];
                            selected: root.subtitles.color;
                            chosen(index) => {
                                root.subtitles-changed({
                                    size: root.subtitles.size,
                                    color: index,
                                    background: root.subtitles.background,
                                    position: root.subtitles.position,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Background");
                            options: [@tr("Outline"), @tr("Box")];
                            selected: root.subtitles.background;
                            chosen(index) => {
                                root.subtitles-changed({
                                    size: root.subtitles.size,
                                    color: root.subtitles.color,
                                    background: index,
                                    position: root.subtitles.position,
                                });
                            }
                        }
                        ChoiceRow {
                            label: @tr("Position");
                            options: [@tr("Bottom"), @tr("Raised")];
                            selected: root.subtitles.position;
                            chosen(index) => {
                                root.subtitles-changed({
                                    size: root.subtitles.size,
                                    color: root.subtitles.color,
                                    background: root.subtitles.background,
                                    position: index,
                                });
                            }
                        }
                    }

                    SettingSection {
                        title: @tr("Devices");

                        CaptionText {
                            text: @tr("Sign in another device: open Quick Connect on it, then type the code it shows.");
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-md;

                            TextField {
                                horizontal-stretch: 1;
                                label: @tr("Quick Connect code");
                                text <=> root.authorize-code;
                                enabled: root.authorize-state != AuthorizeState.busy;
                                edited => {
                                    if root.authorize-state != AuthorizeState.busy {
                                        root.authorize-state = AuthorizeState.idle;
                                    }
                                }
                                accepted => {
                                    root.submit-code();
                                }
                            }
                            VerticalLayout {
                                alignment: end;

                                Button {
                                    label: @tr("Authorize");
                                    enabled: root.can-authorize;
                                    clicked => {
                                        root.submit-code();
                                    }
                                }
                            }
                        }
                        if root.authorize-state != AuthorizeState.idle && root.authorize-state != AuthorizeState.busy: LabelText {
                            accessible-role: text;
                            text: root.authorize-state == AuthorizeState.done ? @tr("Device authorized")
                                : root.authorize-state == AuthorizeState.wrong-code ? @tr("This code is wrong or expired")
                                : root.authorize-state == AuthorizeState.unavailable ? @tr("Quick Connect is turned off on this server")
                                : @tr("The device could not be authorized. Try again.");
                            color: root.authorize-state == AuthorizeState.done ? Theme.watched : Theme.danger;
                            wrap: word-wrap;
                        }
                    }

                    SettingSection {
                        title: @tr("About");

                        SettingRow {
                            label: @tr("Version");
                            // Brand name, not translated.
                            value: "Oxyfin \{root.version}";
                        }
                    }
                }
            }
        }

        top-bar := TopBar {
            y: 0;
            height: self.preferred-height;
            current: TopBarPage.none;
            settings-active: true;
            home-clicked => {
                root.open-tab(TopBarPage.home);
            }
            movies-clicked => {
                root.open-tab(TopBarPage.movies);
            }
            shows-clicked => {
                root.open-tab(TopBarPage.shows);
            }
            favorites-clicked => {
                root.open-tab(TopBarPage.favorites);
            }
            search-clicked => {
                root.open-tab(TopBarPage.search);
            }
            settings-clicked => {
                root.back();
            }
        }
    }

    init => {
        keys.focus();
    }
}
