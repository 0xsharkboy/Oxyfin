import { Spinner } from "std-widgets.slint";
import { Theme, Message, Messages, TrackRow, NextUp } from "../theme.slint";
import { Icons } from "../icons.slint";
import { IconButton } from "../components/icon_button.slint";
import { BodyText, HeadingText, LabelText } from "../components/text.slint";
import { PlayerControls } from "../components/player_controls.slint";
import { TrackMenu } from "../components/track_menu.slint";
import { SpeedMenu } from "../components/speed_menu.slint";
import { NextEpisodeToast } from "../components/next_episode_toast.slint";

export enum PlayerMenu { none, tracks, speed }

// Video player. The window is transparent here so the video drawn under the interface shows.
export component PlayerScreen inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> loading;
    in property <bool> has-error;
    in property <Message> error;
    // Whether the video renderer drew a frame for the current session.
    in property <bool> video-active;
    in property <float> position;
    in property <float> duration;
    in property <string> elapsed;
    in property <string> total;
    in property <bool> paused;
    in property <float> volume;
    in property <bool> muted;
    in property <float> speed;
    in property <[float]> speeds;
    in property <bool> has-next;
    in property <[TrackRow]> audio;
    in property <[TrackRow]> subtitles;
    in property <NextUp> next-up;
    in property <bool> fullscreen;
    in-out property <bool> scrubbing;
    out property <bool> controls-visible: root.awake || root.paused || root.menu != PlayerMenu.none || root.scrubbing || root.loading || root.has-error;

    callback back();
    callback toggle-fullscreen();
    // The cursor only changes on a pointer event: the window replays one where the pointer rests.
    callback cursor-hidden(x: length, y: length);
    callback command-set-paused(paused: bool);
    callback command-seek(seconds: float);
    callback command-skip(direction: int);
    callback command-previous();
    callback command-next();
    callback command-play-next-now();
    callback command-cancel-next-up();
    callback command-set-speed(speed: float);
    callback command-step-speed(direction: int);
    callback command-set-volume(volume: float);
    callback command-step-volume(direction: int);
    callback command-set-muted(muted: bool);
    callback command-select-audio(index: int);
    callback command-select-subtitle(index: int);

    property <PlayerMenu> menu: PlayerMenu.none;
    // False once the pointer rested for the hide delay while playing.
    property <bool> awake: true;
    property <length> button-size: 24px + 2 * Theme.space-sm;
    property <length> menu-bottom: controls.y + Theme.space-3xl - Theme.space-xl;
    property <length> menu-max-height: root.menu-bottom - top-bar.height;

    function reveal() {
        root.awake = true;
        if hide-timer.running {
            hide-timer.restart();
        }
    }

    function toggle-menu(menu: PlayerMenu) {
        root.menu = root.menu == menu ? PlayerMenu.none : menu;
    }

    function escape() {
        if root.fullscreen {
            root.toggle-fullscreen();
        } else if root.menu != PlayerMenu.none {
            root.menu = PlayerMenu.none;
        } else {
            root.back();
        }
    }

    accessible-role: groupbox;
    accessible-label: @tr("Player");

    // Covers the window until the first frame, so the desktop never shows through.
    background: root.loading || root.has-error || !root.video-active ? Theme.video-backdrop : transparent;

    hide-timer := Timer {
        interval: 3s;
        running: root.awake && !root.paused && root.menu == PlayerMenu.none && !root.scrubbing && !root.loading && !root.has-error;
        triggered => {
            root.awake = false;
            if surface.has-hover {
                root.cursor-hidden(surface.mouse-x, surface.mouse-y);
            }
        }
    }

    // Ancestor of every control, so it sees each pointer move, even over a button.
    surface := TouchArea {
        mouse-cursor: root.controls-visible ? MouseCursor.default : MouseCursor.none;
        changed mouse-x => {
            root.reveal();
        }
        changed mouse-y => {
            root.reveal();
        }
        clicked => {
            root.menu = PlayerMenu.none;
            keys.focus();
        }
        double-clicked => {
            root.toggle-fullscreen();
        }

        keys := FocusScope {
            init => {
                self.focus();
            }
            // Captured before any focused control, so the shortcuts work wherever focus is.
            capture-key-pressed(event) => {
                if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                    return reject;
                }
                if event.text == " " {
                    root.command-set-paused(!root.paused);
                } else if event.text == Key.LeftArrow {
                    root.command-skip(-1);
                } else if event.text == Key.RightArrow {
                    root.command-skip(1);
                } else if event.text == Key.UpArrow {
                    root.command-step-volume(1);
                } else if event.text == Key.DownArrow {
                    root.command-step-volume(-1);
                } else if event.text == "f" || event.text == "F" {
                    root.toggle-fullscreen();
                } else if event.text == "m" || event.text == "M" {
                    root.command-set-muted(!root.muted);
                } else if event.text == "[" {
                    root.command-step-speed(-1);
                } else if event.text == "]" {
                    root.command-step-speed(1);
                } else if event.text == "n" || event.text == "N" {
                    if root.has-next {
                        root.command-next();
                    }
                } else if event.text == "p" || event.text == "P" {
                    root.command-previous();
                } else if event.text == Key.Escape {
                    root.escape();
                } else {
                    return reject;
                }
                root.reveal();
                accept
            }

            if root.loading && !root.has-error: Spinner {
                indeterminate: true;
                width: 48px;
                height: 48px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if root.has-error: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 2 * Theme.space-3xl, 480px);
                height: error-text.preferred-height + 2 * Theme.space-xl;
                background: Theme.bg-elevated;
                border-radius: Theme.radius-lg;
                border-width: Theme.border-thin;
                border-color: Theme.border-default;

                error-text := BodyText {
                    accessible-role: text;
                    x: Theme.space-xl;
                    width: parent.width - 2 * Theme.space-xl;
                    text: Messages.message-text(root.error, "");
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            top-bar := Rectangle {
                y: 0;
                height: top-layout.preferred-height;
                background: Theme.player-scrim-top;
                visible: root.controls-visible;

                top-layout := HorizontalLayout {
                    padding-left: Theme.space-2xl;
                    padding-right: Theme.space-2xl;
                    padding-top: Theme.space-xl;
                    padding-bottom: Theme.space-3xl;
                    spacing: Theme.space-lg;
                    alignment: start;

                    VerticalLayout {
                        alignment: start;
                        IconButton {
                            icon: Icons.arrow-left;
                            label: @tr("Back");
                            clicked => {
                                root.back();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: start;
                        spacing: Theme.space-2xs;

                        HeadingText {
                            text: root.title;
                            overflow: elide;
                        }

                        if root.subtitle != "": LabelText {
                            text: root.subtitle;
                            overflow: elide;
                        }
                    }
                }
            }

            controls := PlayerControls {
                y: parent.height - self.height;
                width: parent.width;
                visible: root.controls-visible;
                position: root.position;
                duration: root.duration;
                elapsed: root.elapsed;
                total: root.total;
                paused: root.paused;
                has-next: root.has-next;
                volume: root.volume;
                muted: root.muted;
                tracks-open: root.menu == PlayerMenu.tracks;
                speed-open: root.menu == PlayerMenu.speed;
                fullscreen: root.fullscreen;
                scrubbing <=> root.scrubbing;
                toggle-pause => {
                    root.command-set-paused(!root.paused);
                }
                seek(seconds) => {
                    root.command-seek(seconds);
                }
                skip(direction) => {
                    root.command-skip(direction);
                }
                previous => {
                    root.command-previous();
                }
                next => {
                    root.command-next();
                }
                set-volume(volume) => {
                    root.command-set-volume(volume);
                }
                step-volume(direction) => {
                    root.command-step-volume(direction);
                }
                toggle-mute => {
                    root.command-set-muted(!root.muted);
                }
                toggle-tracks => {
                    root.toggle-menu(PlayerMenu.tracks);
                }
                toggle-speed => {
                    root.toggle-menu(PlayerMenu.speed);
                }
                toggle-fullscreen => {
                    root.toggle-fullscreen();
                }
            }

            if root.menu == PlayerMenu.tracks: TrackMenu {
                x: parent.width - self.width - Theme.space-2xl - 2 * (root.button-size + Theme.space-sm);
                y: root.menu-bottom - self.height;
                limit: root.menu-max-height;
                audio: root.audio;
                subtitles: root.subtitles;
                select-audio(index) => {
                    root.command-select-audio(index);
                }
                select-subtitle(index) => {
                    root.command-select-subtitle(index);
                }
            }

            if root.menu == PlayerMenu.speed: SpeedMenu {
                x: parent.width - self.width - Theme.space-2xl - root.button-size - Theme.space-sm;
                y: root.menu-bottom - self.height;
                limit: root.menu-max-height;
                speeds: root.speeds;
                speed: root.speed;
                select(speed) => {
                    root.command-set-speed(speed);
                    root.menu = PlayerMenu.none;
                }
            }

            if root.next-up.visible: NextEpisodeToast {
                x: parent.width - self.width - Theme.space-2xl;
                y: (root.controls-visible ? root.menu-bottom : parent.height - Theme.space-2xl) - self.height;
                next-up: root.next-up;
                play-now => {
                    root.command-play-next-now();
                }
                cancel => {
                    root.command-cancel-next-up();
                }
            }
        }
    }
}
