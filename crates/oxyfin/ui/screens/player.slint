import { Spinner } from "std-widgets.slint";
import { Theme, Message, Messages, TrackRow, NextUp, QualityRow, SeekPreview, SkipKind, Skipped, ChapterRow, StatSection } from "../theme.slint";
import { SeekPreviewPopup } from "../components/seek_preview.slint";
import { Icons } from "../icons.slint";
import { Button, ButtonStyle } from "../components/button.slint";
import { IconButton } from "../components/icon_button.slint";
import { BodyStrongText, BodyText, HeadingText, LabelText } from "../components/text.slint";
import { PlayerControls } from "../components/player_controls.slint";
import { TrackMenu } from "../components/track_menu.slint";
import { SpeedMenu } from "../components/speed_menu.slint";
import { ChapterMenu } from "../components/chapter_menu.slint";
import { NextEpisodeToast } from "../components/next_episode_toast.slint";
import { SkipNotice } from "../components/skip_notice.slint";
import { StatsPanel } from "../components/stats_panel.slint";
import { SubtitleSearch, SubtitleSearchDialog } from "../components/subtitle_search.slint";

export enum PlayerMenu { none, tracks, speed, chapters, subtitles }

enum OsdKind { none, audio-delay, subtitle-delay, volume }

// Video player. The window is transparent here so the video drawn under the interface shows.
export component PlayerScreen inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> loading;
    in property <bool> has-error;
    in property <Message> error;
    // Whether the video renderer drew a frame for the current session.
    in property <bool> video-active;
    in property <float> position;
    in property <float> duration;
    in property <string> elapsed;
    in property <string> total;
    in property <string> remaining;
    // Whether the time shows what is left rather than the total; a click on it switches.
    in-out property <bool> time-remaining;
    in property <bool> paused;
    in property <float> volume;
    in property <bool> muted;
    in property <float> speed;
    in property <[float]> speeds;
    in property <[QualityRow]> qualities;
    // Index in `qualities` of the chosen quality.
    in property <int> quality;
    in property <bool> has-next;
    in property <[TrackRow]> audio;
    in property <[TrackRow]> subtitles;
    // Delays in milliseconds.
    in property <int> audio-delay;
    in property <int> subtitle-delay;
    in property <[ChapterRow]> chapters;
    // Index in `chapters` of the chapter playing, -1 for none.
    in property <int> current-chapter: -1;
    // Where each chapter but the first starts, as fractions of the duration.
    in property <[float]> chapter-marks;
    in property <NextUp> next-up;
    in property <SkipKind> skip-kind;
    in property <float> skip-end;
    // The last segment skipped without asking, shown for a moment with a way back.
    in property <Skipped> skipped;
    in property <bool> fullscreen;
    // Whether the player turned fullscreen on, so Escape leaves it.
    in property <bool> fullscreen-own;
    in-out property <bool> scrubbing;
    in property <SeekPreview> preview;
    in property <[StatSection]> stats;
    // Whether the playback statistics show; they are asked for every second while they do.
    in-out property <bool> stats-visible;
    out property <bool> controls-visible: root.awake || root.paused || root.menu-open || root.scrubbing || root.loading || root.has-error;

    callback back();
    callback toggle-fullscreen();
    // The cursor only changes on a pointer event: the window replays one where the pointer rests.
    callback cursor-hidden(x: length, y: length);
    callback command-set-paused(paused: bool);
    callback command-seek(seconds: float);
    callback command-skip(direction: int);
    callback command-previous();
    callback command-next();
    callback command-play-next-now();
    callback command-cancel-next-up();
    callback command-undo-skip();
    callback command-skip-segment();
    callback command-set-speed(speed: float);
    callback command-step-speed(direction: int);
    callback command-set-quality(index: int);
    callback command-set-volume(volume: float);
    callback command-step-volume(direction: int);
    callback command-set-muted(muted: bool);
    callback command-select-audio(index: int);
    callback command-select-subtitle(index: int);
    callback command-step-audio-delay(direction: int);
    callback command-set-audio-delay(ms: int);
    callback command-step-subtitle-delay(direction: int);
    callback command-set-subtitle-delay(ms: int);
    // Jump to the next chapter, or back like mpv for a negative direction.
    callback command-step-chapter(direction: int);
    callback command-stats();
    // The pointer hovers or drags the seek bar at `seconds`: the preview should show that time.
    callback preview-requested(seconds: float);
    callback time-remaining-changed(remaining: bool);

    property <PlayerMenu> menu: PlayerMenu.none;
    // A menu or the statistics show above the bar; one at a time.
    property <bool> menu-open: root.menu != PlayerMenu.none || root.stats-visible;
    // The menus cover the skip column, unlike the statistics, which leave room for it.
    property <bool> popup-open: root.menu != PlayerMenu.none;
    // The delay a shortcut or the volume the wheel changed, shown for a moment over the video.
    property <OsdKind> osd: OsdKind.none;
    // Wheel scrolling not yet turned into volume steps.
    property <length> wheel-delta;
    // What one notch of a mouse wheel scrolls: one volume step.
    property <length> wheel-notch: 60px;
    // Whether the last click and the one before it landed on the video, and the pause state
    // before each: a double click puts back the state from before its first click.
    property <bool> last-click-video;
    property <bool> previous-click-video;
    property <bool> paused-before-last-click;
    property <bool> paused-before-previous-click;
    // When and where the pointer last pressed a control that went away with that click.
    property <duration> vanished-tick: -3600s;
    property <length> vanished-x;
    property <length> vanished-y;
    // The pause indicator: whether it shows pause, whether it shows at all, and whether it fades.
    property <bool> indicator-paused;
    property <bool> indicator-active;
    property <bool> indicator-fading;
    // False once the pointer rested for the hide delay while playing.
    property <bool> awake: true;
    // The controls stay up while the pointer rests on them, such as on the seek bar preview.
    property <bool> pointer-on-controls: surface.has-hover && root.controls-visible && surface.mouse-y >= controls.y;
    property <length> button-size: 24px + 2 * Theme.space-sm;
    property <length> menu-bottom: controls.y + Theme.space-3xl - Theme.space-xl;
    property <length> menu-max-height: root.menu-bottom - top-bar.height;
    // The skip column and the next episode toast, one at a time, go left of the statistics, or
    // above them, under the top bar, where the window is too narrow.
    property <length> stack-width: max(skip-column.preferred-width, toast.preferred-width);
    property <length> stack-height: max(skip-column.preferred-height, toast.preferred-height);
    property <bool> stack-above: root.stats-visible && root.width - 2 * Theme.space-2xl - Theme.stats-panel-width - Theme.space-sm < max(root.stack-width, Theme.skip-room-width);
    property <length> stack-right: root.width - Theme.space-2xl - (root.stats-visible && !root.stack-above ? Theme.stats-panel-width + Theme.space-sm : 0);
    property <length> stack-bottom: root.stack-above ? top-bar.height + root.stack-height : root.controls-visible ? root.menu-bottom : root.height - Theme.space-2xl;

    function reveal() {
        root.awake = true;
        if hide-timer.running {
            hide-timer.restart();
        }
    }

    function step-delay(kind: OsdKind, direction: int) {
        if kind == OsdKind.audio-delay {
            root.command-step-audio-delay(direction);
        } else {
            root.command-step-subtitle-delay(direction);
        }
        root.osd = kind;
        osd-timer.restart();
    }

    function on-video(y: length) -> bool {
        !root.controls-visible || (y >= top-bar.height && y < controls.y)
    }

    // The control under the pointer goes away: the second click of a double click on it is not
    // one on the video.
    function control-vanished() {
        root.vanished-tick = animation-tick();
        root.vanished-x = surface.mouse-x;
        root.vanished-y = surface.mouse-y;
    }

    function on-vanished-control() -> bool {
        animation-tick() - root.vanished-tick < Theme.double-click-interval && abs(surface.mouse-x - root.vanished-x) < Theme.double-click-distance && abs(surface.mouse-y - root.vanished-y) < Theme.double-click-distance
    }

    function pause-from-click() {
        root.indicator-paused = !root.paused;
        root.command-set-paused(root.indicator-paused);
        root.indicator-fading = false;
        root.indicator-active = true;
        indicator-hold.restart();
    }

    function toggle-stats() {
        root.menu = PlayerMenu.none;
        root.stats-visible = !root.stats-visible;
        if root.stats-visible {
            root.command-stats();
        }
    }

    function close-menus() {
        root.menu = PlayerMenu.none;
        root.stats-visible = false;
    }

    function toggle-menu(menu: PlayerMenu) {
        root.stats-visible = false;
        root.menu = root.menu == menu ? PlayerMenu.none : menu;
    }

    function escape() {
        if root.menu-open {
            root.close-menus();
        } else if root.fullscreen && root.fullscreen-own {
            // The fullscreen of a fullscreen launch stays: Escape goes back instead.
            root.toggle-fullscreen();
        } else {
            root.back();
        }
    }

    // A new item closes the subtitle search of the previous one.
    property <string> search-item: SubtitleSearch.item;
    changed search-item => {
        if root.menu == PlayerMenu.subtitles {
            root.menu = PlayerMenu.none;
        }
    }

    // Slint drops the focus of an element that disappears, which would silence the shortcuts:
    // the player buttons never take focus on click, and the shortcuts take it back when a
    // control reached with Tab hides.
    property <bool> has-chapters: root.chapters.length > 0;
    changed has-chapters => {
        if !self.has-chapters && root.menu == PlayerMenu.chapters {
            root.menu = PlayerMenu.none;
        }
    }

    property <bool> toast-visible: root.next-up.visible;
    changed toast-visible => {
        if !self.toast-visible {
            keys.focus();
        }
    }
    // Stays up while the controls hide, like the skip buttons of common players.
    property <bool> skip-visible: root.skip-kind != SkipKind.none && !root.toast-visible && !root.popup-open && !root.loading && !root.has-error;
    changed skip-visible => {
        if !self.skip-visible {
            keys.focus();
        }
    }

    // Serial of the last skip whose notice timed out or was answered.
    property <int> skip-notice-done: 0;
    property <bool> skip-notice-visible: root.skipped.kind != SkipKind.none && root.skipped.serial != root.skip-notice-done && !root.toast-visible && !root.popup-open && !root.loading && !root.has-error;
    changed skipped => {
        if skip-notice-timer.running {
            skip-notice-timer.restart();
        }
    }

    function skip-segment() {
        if root.skip-visible {
            root.command-skip-segment();
        }
    }

    accessible-role: groupbox;
    accessible-label: @tr("Player");

    // Covers the window until the first frame, so the desktop never shows through.
    background: root.loading || root.has-error || !root.video-active ? Theme.video-backdrop : transparent;

    stats-timer := Timer {
        interval: 1s;
        running: root.stats-visible;
        triggered => {
            root.command-stats();
        }
    }

    skip-notice-timer := Timer {
        interval: 5s;
        running: root.skip-notice-visible;
        triggered => {
            root.skip-notice-done = root.skipped.serial;
        }
    }

    osd-timer := Timer {
        interval: 1.5s;
        running: root.osd != OsdKind.none;
        triggered => {
            root.osd = OsdKind.none;
        }
    }

    indicator-hold := Timer {
        interval: Theme.pause-indicator-hold;
        running: root.indicator-active && !root.indicator-fading;
        triggered => {
            root.indicator-fading = true;
        }
    }

    indicator-end := Timer {
        interval: Theme.pause-indicator-fade;
        running: root.indicator-fading;
        triggered => {
            root.indicator-active = false;
            root.indicator-fading = false;
        }
    }

    hide-timer := Timer {
        interval: 3s;
        running: root.awake && !root.paused && !root.menu-open && !root.scrubbing && !root.loading && !root.has-error && !root.pointer-on-controls;
        triggered => {
            root.awake = false;
            keys.focus();
            if surface.has-hover {
                root.cursor-hidden(surface.mouse-x, surface.mouse-y);
            }
        }
    }

    // Ancestor of every control, so it sees each pointer move, even over a button.
    surface := TouchArea {
        mouse-cursor: root.controls-visible ? MouseCursor.default : MouseCursor.none;
        changed mouse-x => {
            root.reveal();
        }
        changed mouse-y => {
            root.reveal();
        }
        clicked => {
            root.previous-click-video = root.last-click-video;
            root.last-click-video = false;
            if root.menu-open {
                root.close-menus();
            } else if root.on-video(self.mouse-y) && !root.on-vanished-control() {
                root.last-click-video = true;
                root.paused-before-previous-click = root.paused-before-last-click;
                root.paused-before-last-click = root.paused;
                if !root.loading && !root.has-error {
                    root.pause-from-click();
                }
            }
            keys.focus();
        }
        scroll-event(event) => {
            if root.menu-open || !root.on-video(self.mouse-y) || event.delta-y == 0 {
                return reject;
            }
            if (root.wheel-delta > 0 && event.delta-y < 0) || (root.wheel-delta < 0 && event.delta-y > 0) {
                root.wheel-delta = 0;
            }
            root.wheel-delta += event.delta-y;
            if abs(root.wheel-delta) >= root.wheel-notch {
                root.command-step-volume(root.wheel-delta > 0 ? 1 : -1);
                root.wheel-delta = 0;
                root.osd = OsdKind.volume;
                osd-timer.restart();
            }
            accept
        }
        // Slint calls `clicked` for both clicks first, so each toggled pause: undo them.
        double-clicked => {
            if !root.previous-click-video || !root.last-click-video {
                return;
            }
            root.last-click-video = false;
            if !root.loading && !root.has-error {
                root.indicator-active = false;
                root.command-set-paused(root.paused-before-previous-click);
            }
            root.toggle-fullscreen();
        }

        keys := FocusScope {
            init => {
                self.focus();
            }
            // Captured before any focused control, so the shortcuts work wherever focus is.
            capture-key-pressed(event) => {
                // The subtitle search keeps the keys for its own buttons, but Escape closes it.
                if root.menu == PlayerMenu.subtitles {
                    if event.text == Key.Escape {
                        root.escape();
                        return accept;
                    }
                    return reject;
                }
                // mpv default bindings: Ctrl with plus or minus for the audio delay.
                if event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                    if event.text == "+" || event.text == "=" {
                        root.step-delay(OsdKind.audio-delay, 1);
                    } else if event.text == "-" {
                        root.step-delay(OsdKind.audio-delay, -1);
                    } else {
                        return reject;
                    }
                    root.reveal();
                    return accept;
                }
                if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                    return reject;
                }
                if event.text == " " {
                    root.command-set-paused(!root.paused);
                } else if event.text == Key.LeftArrow {
                    root.command-skip(-1);
                } else if event.text == Key.RightArrow {
                    root.command-skip(1);
                } else if event.text == Key.UpArrow {
                    root.command-step-volume(1);
                } else if event.text == Key.DownArrow {
                    root.command-step-volume(-1);
                } else if event.text == "f" || event.text == "F" {
                    root.toggle-fullscreen();
                } else if event.text == "m" || event.text == "M" {
                    root.command-set-muted(!root.muted);
                } else if event.text == "[" {
                    root.command-step-speed(-1);
                } else if event.text == "]" {
                    root.command-step-speed(1);
                } else if event.text == "n" || event.text == "N" {
                    if root.has-next {
                        root.command-next();
                    }
                } else if event.text == "p" || event.text == "P" {
                    root.command-previous();
                } else if event.text == "s" || event.text == "S" {
                    root.skip-segment();
                } else if event.text == "i" || event.text == "I" {
                    root.toggle-stats();
                } else if event.text == Key.PageUp {
                    root.command-step-chapter(-1);
                } else if event.text == Key.PageDown {
                    root.command-step-chapter(1);
                } else if event.text == "z" {
                    root.step-delay(OsdKind.subtitle-delay, -1);
                } else if event.text == "Z" || event.text == "x" || event.text == "X" {
                    root.step-delay(OsdKind.subtitle-delay, 1);
                } else if event.text == Key.Escape {
                    root.escape();
                } else {
                    return reject;
                }
                root.reveal();
                accept
            }

            if root.loading && !root.has-error: Spinner {
                indeterminate: true;
                width: 48px;
                height: 48px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if root.has-error: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 2 * Theme.space-3xl, 480px);
                height: error-text.preferred-height + 2 * Theme.space-xl;
                background: Theme.bg-elevated;
                border-radius: Theme.radius-lg;
                border-width: Theme.border-thin;
                border-color: Theme.border-default;

                error-text := BodyText {
                    accessible-role: text;
                    x: Theme.space-xl;
                    width: parent.width - 2 * Theme.space-xl;
                    text: Messages.message-text(root.error, "");
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            top-bar := Rectangle {
                y: 0;
                height: top-layout.preferred-height;
                background: Theme.player-scrim-top;
                visible: root.controls-visible;

                top-layout := HorizontalLayout {
                    padding-left: Theme.space-2xl;
                    padding-right: Theme.space-2xl;
                    padding-top: Theme.space-xl;
                    padding-bottom: Theme.space-3xl;
                    spacing: Theme.space-lg;
                    alignment: start;

                    VerticalLayout {
                        alignment: start;
                        IconButton {
                            focus-on-click: false;
                            icon: Icons.arrow-left;
                            label: @tr("Back");
                            clicked => {
                                root.back();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: start;
                        spacing: Theme.space-2xs;

                        HeadingText {
                            text: root.title;
                            overflow: elide;
                        }

                        if root.subtitle != "": LabelText {
                            text: root.subtitle;
                            overflow: elide;
                        }
                    }
                }
            }

            controls := PlayerControls {
                y: parent.height - self.height;
                width: parent.width;
                visible: root.controls-visible;
                position: root.position;
                duration: root.duration;
                elapsed: root.elapsed;
                total: root.total;
                remaining: root.remaining;
                time-remaining: root.time-remaining;
                paused: root.paused;
                has-next: root.has-next;
                volume: root.volume;
                muted: root.muted;
                tracks-open: root.menu == PlayerMenu.tracks;
                has-chapters: root.has-chapters;
                chapters-open: root.menu == PlayerMenu.chapters;
                chapter-marks: root.chapter-marks;
                speed-open: root.menu == PlayerMenu.speed;
                stats-open: root.stats-visible;
                fullscreen: root.fullscreen;
                scrubbing <=> root.scrubbing;
                toggle-pause => {
                    root.command-set-paused(!root.paused);
                }
                seek(seconds) => {
                    root.command-seek(seconds);
                }
                skip(direction) => {
                    root.command-skip(direction);
                }
                previous => {
                    root.command-previous();
                }
                next => {
                    root.command-next();
                }
                set-volume(volume) => {
                    root.command-set-volume(volume);
                }
                step-volume(direction) => {
                    root.command-step-volume(direction);
                }
                toggle-mute => {
                    root.command-set-muted(!root.muted);
                }
                toggle-tracks => {
                    root.toggle-menu(PlayerMenu.tracks);
                }
                toggle-chapters => {
                    root.toggle-menu(PlayerMenu.chapters);
                }
                toggle-speed => {
                    root.toggle-menu(PlayerMenu.speed);
                }
                toggle-stats => {
                    root.toggle-stats();
                }
                toggle-time => {
                    root.time-remaining = !root.time-remaining;
                    root.time-remaining-changed(root.time-remaining);
                }
                toggle-fullscreen => {
                    root.toggle-fullscreen();
                }
                seek-hovered(seconds) => {
                    root.preview-requested(seconds);
                }
            }

            if root.menu == PlayerMenu.tracks: TrackMenu {
                x: parent.width - self.width - Theme.space-2xl - 3 * (root.button-size + Theme.space-sm);
                y: root.menu-bottom - self.height;
                limit: root.menu-max-height;
                audio: root.audio;
                subtitles: root.subtitles;
                select-audio(index) => {
                    root.command-select-audio(index);
                }
                audio-delay: root.audio-delay;
                subtitle-delay: root.subtitle-delay;
                can-find-subtitles: SubtitleSearch.allowed;
                find-subtitles => {
                    root.menu = PlayerMenu.subtitles;
                    SubtitleSearch.opened();
                }
                select-subtitle(index) => {
                    root.command-select-subtitle(index);
                }
                step-audio-delay(direction) => {
                    root.command-step-audio-delay(direction);
                }
                reset-audio-delay => {
                    root.command-set-audio-delay(0);
                }
                step-subtitle-delay(direction) => {
                    root.command-step-subtitle-delay(direction);
                }
                reset-subtitle-delay => {
                    root.command-set-subtitle-delay(0);
                }
            }

            if root.menu == PlayerMenu.chapters: ChapterMenu {
                x: parent.width - self.width - Theme.space-2xl;
                y: root.menu-bottom - self.height;
                limit: root.menu-max-height;
                chapters: root.chapters;
                current: root.current-chapter;
                chosen(start) => {
                    root.control-vanished();
                    root.command-seek(start);
                    root.menu = PlayerMenu.none;
                }
            }

            if root.stats-visible: StatsPanel {
                x: parent.width - self.width - Theme.space-2xl;
                y: root.menu-bottom - self.height;
                // Where the skip button goes above, its room is kept so the panel never jumps.
                limit: root.menu-max-height - (root.stack-above ? max(root.stack-height, Theme.button-height) + Theme.space-sm : 0px);
                sections: root.stats;
            }

            if root.menu == PlayerMenu.speed: SpeedMenu {
                x: parent.width - self.width - Theme.space-2xl - root.button-size - Theme.space-sm;
                y: root.menu-bottom - self.height;
                limit: root.menu-max-height;
                speeds: root.speeds;
                speed: root.speed;
                select(speed) => {
                    root.control-vanished();
                    root.command-set-speed(speed);
                    root.menu = PlayerMenu.none;
                }
                qualities: root.qualities;
                quality: root.quality;
                select-quality(index) => {
                    root.control-vanished();
                    root.command-set-quality(index);
                    root.menu = PlayerMenu.none;
                }
            }

            // The notice of a skip stacks above the skip button of the next segment.
            skip-column := VerticalLayout {
                width: self.preferred-width;
                height: self.preferred-height;
                x: root.stack-right - self.width;
                y: root.stack-bottom - self.height;
                spacing: Theme.space-sm;

                if root.skip-notice-visible: HorizontalLayout {
                    alignment: end;

                    SkipNotice {
                        kind: root.skipped.kind;
                        undo => {
                            root.control-vanished();
                            root.skip-notice-done = root.skipped.serial;
                            root.command-undo-skip();
                        }
                    }
                }

                if root.skip-visible: HorizontalLayout {
                    alignment: end;

                    Button {
                        focus-on-click: false;
                        style: ButtonStyle.secondary;
                        icon: Icons.skip-next;
                        label: root.skip-kind == SkipKind.intro ? @tr("Skip intro") : root.skip-kind == SkipKind.recap ? @tr("Skip recap") : root.skip-kind == SkipKind.preview ? @tr("Skip preview") : @tr("Skip credits");
                        drop-shadow-offset-y: 8px;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: Theme.menu-shadow;
                        clicked => {
                            root.control-vanished();
                            root.skip-segment();
                        }
                    }
                }
            }

            toast := VerticalLayout {
                width: self.preferred-width;
                height: self.preferred-height;
                x: root.stack-right - self.width;
                y: root.stack-bottom - self.height;

                if root.next-up.visible: NextEpisodeToast {
                    next-up: root.next-up;
                    play-now => {
                        root.control-vanished();
                        root.command-play-next-now();
                    }
                    cancel => {
                        root.control-vanished();
                        root.command-cancel-next-up();
                    }
                }
            }

            if root.osd != OsdKind.none: osd-pill := Rectangle {
                property <string> name: root.osd == OsdKind.volume ? @tr("Volume") : root.osd == OsdKind.audio-delay ? @tr("Audio delay") : @tr("Subtitle delay");
                property <string> value: root.osd == OsdKind.volume ? @tr("{}%", round(root.volume)) : Messages.delay-text(root.osd == OsdKind.audio-delay ? root.audio-delay : root.subtitle-delay);

                accessible-role: text;
                accessible-label: @tr("{}: {}", self.name, self.value);
                x: (parent.width - self.width) / 2;
                y: 2 * Theme.space-3xl;
                width: osd-row.preferred-width;
                height: osd-row.preferred-height;
                background: Theme.bg-elevated;
                border-radius: Theme.radius-full;
                border-width: Theme.border-thin;
                border-color: Theme.border-default;

                osd-row := HorizontalLayout {
                    padding-left: Theme.space-lg;
                    padding-right: Theme.space-lg;
                    padding-top: Theme.space-pill-y;
                    padding-bottom: Theme.space-pill-y;
                    spacing: Theme.space-sm;

                    if root.osd == OsdKind.volume: VerticalLayout {
                        alignment: center;

                        osd-icon := Image {
                            accessible-role: none;
                            source: controls.volume-icon;
                            width: Theme.link-icon-size;
                            height: Theme.link-icon-size;
                        }
                    }
                    BodyText {
                        accessible-role: none;
                        text: osd-pill.name;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    BodyStrongText {
                        accessible-role: none;
                        text: osd-pill.value;
                        vertical-alignment: center;
                    }
                }
            }

            if root.indicator-active: Rectangle {
                accessible-role: image;
                accessible-label: root.indicator-paused ? @tr("Paused") : @tr("Playing");
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Theme.pause-indicator-size;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.pause-indicator-background;
                opacity: root.indicator-fading ? 0 : 1;
                animate opacity { duration: Theme.pause-indicator-fade; }

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Theme.pause-indicator-icon;
                    height: self.width;
                    source: root.indicator-paused ? Icons.pause : Icons.play;
                }
            }

            // Follows the pointer over the seek bar, kept inside the window. Declared last so
            // that it draws over the skip button and the next episode toast.
            if root.controls-visible && controls.seek-hovering: SeekPreviewPopup {
                x: max(Theme.space-sm, min(parent.width - self.width - Theme.space-sm, controls.x + controls.seek-hover-x - self.width / 2));
                y: controls.y + controls.seek-top - self.height - Theme.space-sm;
                preview: root.preview;
            }

            if root.menu == PlayerMenu.subtitles: Rectangle {
                background: Theme.dialog-scrim;

                // Clicks on the scrim close the dialog and never reach the player.
                TouchArea {
                    clicked => {
                        root.control-vanished();
                        root.menu = PlayerMenu.none;
                        keys.focus();
                    }
                    double-clicked => { }
                }

                SubtitleSearchDialog {
                    width: min(Theme.dialog-width, parent.width - 2 * Theme.space-xl);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    limit: parent.height - 2 * Theme.space-3xl;
                    item: root.subtitle.is-empty ? root.title : root.title + " · " + root.subtitle;
                    close => {
                        root.menu = PlayerMenu.none;
                        keys.focus();
                    }
                }
            }
        }
    }
}
