import { Theme } from "../theme.slint";
import { Button, ButtonStyle } from "../components/button.slint";
import { TextField } from "../components/text_field.slint";
import { Icons } from "../icons.slint";
import { HeadingText, BodyStrongText, CaptionText, LabelText } from "../components/text.slint";
import { AuthPage } from "../components/auth_card.slint";

export enum ServerState { idle, checking, found, error }

export struct ServerStatus {
    state: ServerState,
    text: string,
}

// A server that answered on the local network: `detail` is its address, with its version when known.
export struct FoundServer {
    name: string,
    detail: string,
    address: string,
}

// A server found on the local network: a click fills the address with it.
component FoundServerRow inherits Rectangle {
    in property <FoundServer> server;
    in property <bool> enabled: true;
    callback chosen();

    accessible-role: button;
    accessible-label: root.server.name;
    accessible-description: root.server.detail;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.chosen();
        }
    }

    border-radius: Theme.radius-md;
    border-width: Theme.border-thin;
    border-color: Theme.border-default;
    background: touch.has-hover && root.enabled ? Theme.bg-hover : transparent;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    clip: true;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.chosen();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-sm;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-md;

        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.server;
                width: Theme.found-server-icon-size;
                height: self.width;
            }
        }

        VerticalLayout {
            spacing: Theme.space-2xs;
            horizontal-stretch: 1;

            BodyStrongText {
                accessible-role: none;
                text: root.server.name;
                overflow: elide;
            }
            CaptionText {
                accessible-role: none;
                text: root.server.detail;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.chevron-right;
                width: Theme.found-server-chevron-size;
                height: self.width;
            }
        }
    }
}

// Servers that answered on the local network, under the address field.
component FoundServers inherits VerticalLayout {
    in property <[FoundServer]> servers;
    in property <bool> enabled: true;
    callback chosen(address: string);

    property <length> row-height: Theme.space-sm * 2 + Theme.body-strong-line-height + Theme.space-2xs
        + Theme.caption-line-height + Theme.border-thin * 2;
    property <length> list-height: min(root.servers.length, Theme.found-servers-visible) * (root.row-height + Theme.space-xs)
        - Theme.space-xs;

    accessible-role: list;
    accessible-label: @tr("On your network");
    spacing: Theme.space-xs;

    HorizontalLayout {
        spacing: Theme.space-sm;
        padding-bottom: Theme.space-xs;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.wifi-muted;
                width: Theme.found-server-header-icon-size;
                height: self.width;
            }
        }
        CaptionText {
            accessible-role: none;
            text: @tr("On your network");
            color: Theme.text-muted;
        }
    }

    Flickable {
        mouse-drag-pan-enabled: false;
        height: root.list-height;
        content-height: root.servers.length * (root.row-height + Theme.space-xs) - Theme.space-xs;
        interactive: root.servers.length > Theme.found-servers-visible;

        VerticalLayout {
            spacing: Theme.space-xs;
            for server in root.servers: FoundServerRow {
                height: root.row-height;
                server: server;
                enabled: root.enabled;
                chosen => {
                    root.chosen(server.address);
                }
            }
        }
    }
}

// Sign-in card: server address, credentials, password and Quick Connect buttons.
export component SignInScreen inherits AuthPage {
    in-out property <string> server-address;
    in-out property <string> username;
    in property <ServerStatus> server-status;
    in property <bool> busy;
    in property <string> form-error;
    in property <[FoundServer]> found-servers;
    callback server-changed(address: string);
    callback server-confirmed(address: string);
    callback sign-in(username: string, password: string);
    callback open-quick-connect();
    callback found-server-chosen(address: string);

    property <ServerState> state: server-status.state;
    property <bool> found: state == ServerState.found;
    // A sign-in asked for while the server is being checked, sent once it is found.
    property <bool> queued;
    property <bool> locked: busy || queued;
    property <bool> can-sign-in: (found || state == ServerState.checking) && !locked && !username.is-empty;

    function submit() {
        if !can-sign-in {
            return;
        }
        if found {
            sign-in(username, password.text);
        } else {
            queued = true;
        }
    }

    changed state => {
        if queued && state != ServerState.checking {
            queued = false;
            submit();
        }
    }

    accessible-role: groupbox;
    accessible-label: @tr("Sign in");

    HeadingText {
        text: @tr("Sign in");
    }

    address := TextField {
        label: @tr("Server address");
        placeholder: @tr("https://jellyfin.example.com");
        text <=> root.server-address;
        enabled: !root.locked;
        edited(text) => {
            root.server-changed(text);
        }
        accepted => {
            root.server-confirmed(self.text);
        }
        changed has-focus => {
            if !self.has-focus {
                root.server-confirmed(self.text);
            }
        }
    }

    if root.found-servers.length > 0: FoundServers {
        servers: root.found-servers;
        enabled: !root.locked;
        chosen(address) => {
            root.found-server-chosen(address);
        }
    }

    TextField {
        label: @tr("Username");
        text <=> root.username;
        enabled: !root.locked;
        accepted => {
            password.focus();
        }
    }

    password := TextField {
        label: @tr("Password");
        password: true;
        enabled: !root.locked;
        accepted => {
            root.submit();
        }
    }

    if root.server-status.state != ServerState.idle: HorizontalLayout {
        spacing: Theme.space-sm;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.space-sm;
                height: self.width;
                border-radius: Theme.radius-full;
                background: root.server-status.state == ServerState.found ? Theme.watched
                    : root.server-status.state == ServerState.error ? Theme.danger : Theme.text-muted;
            }
        }
        CaptionText {
            accessible-role: text;
            text: root.server-status.state == ServerState.checking ? @tr("Checking the server…") : root.server-status.text;
            color: root.server-status.state == ServerState.error ? Theme.danger : Theme.text-secondary;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }

    if !root.form-error.is-empty: LabelText {
        accessible-role: text;
        text: root.form-error;
        color: Theme.danger;
        wrap: word-wrap;
    }

    Button {
        label: @tr("Sign in");
        enabled: root.can-sign-in;
        clicked => {
            root.submit();
        }
    }

    HorizontalLayout {
        spacing: Theme.space-md;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle {
                height: Theme.border-thin;
                background: Theme.border-default;
            }
        }
        CaptionText {
            text: @tr("or");
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle {
                height: Theme.border-thin;
                background: Theme.border-default;
            }
        }
    }

    Button {
        label: @tr("Use Quick Connect");
        style: ButtonStyle.ghost;
        enabled: root.found && !root.locked;
        clicked => {
            root.open-quick-connect();
        }
    }
}
