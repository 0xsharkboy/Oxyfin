# Maintainer: 0xsharkboy <https://github.com/0xsharkboy>

pkgname=oxyfin-git
_appid=io.github._0xsharkboy.Oxyfin
pkgver=r286.dda5b26
pkgrel=1
pkgdesc='Native client for Jellyfin media servers'
arch=('x86_64' 'aarch64')
url='https://github.com/0xsharkboy/Oxyfin'
license=('GPL-3.0-only')
depends=('dbus' 'fontconfig' 'glibc' 'hicolor-icon-theme' 'libgcc' 'libglvnd' 'libxkbcommon' 'mpv' 'wayland')
makedepends=('git' 'cargo' 'cmake')
provides=('oxyfin')
conflicts=('oxyfin')
# makepkg's LTO flags turn the C objects of aws-lc-sys into bitcode that the Rust link step cannot use.
options=('!lto' '!debug')
source=("oxyfin::git+https://github.com/0xsharkboy/Oxyfin.git")
sha256sums=('SKIP')

pkgver() {
  cd oxyfin
  (
    set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
      printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

prepare() {
  cd oxyfin
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd oxyfin
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p oxyfin
}

check() {
  cd oxyfin
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p oxyfin-core
}

package() {
  cd oxyfin
  install -Dm755 target/release/oxyfin "$pkgdir/usr/bin/oxyfin"
  install -Dm644 "data/$_appid.desktop" "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "data/$_appid.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_appid.svg"
  install -Dm644 "data/$_appid.metainfo.xml" "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"
}
